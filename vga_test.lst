 93   807A              ; -------------------------------------------------------------------------
 94   807A              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 95   807A              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 96   807A              ; -------------------------------------------------------------------------
 97   807A              OpenATMShadowPorts:
 98   807A 01 8A 80             LD      BC,ShadowPortsOpened
 99   807D C5                   PUSH    BC
100   807E 01 53 2A             LD      BC,$2A53
101   8081 C5                   PUSH    BC
102   8082 01 77 01             LD      BC,$0177
103   8085 3E C3                LD      A,$C3
104   8087 C3 2F 3D             JP      $3D2F
105   808A              ShadowPortsOpened:
106   808A C9                   RET
107   808B
108   808B              ; A = indexed VGA register, E = value.
109   808B              WriteVgaRegister:
110   808B 01 E0 03             LD      BC,$03E0
111   808E ED 79                OUT     (C),A
112   8090 7B                   LD      A,E
113   8091 0C                   INC     C
114   8092 ED 79                OUT     (C),A
115   8094 C9                   RET
116   8095
117   8095              ; -------------------------------------------------------------------------
118   8095              ; Fill the 640x480x16 framebuffer.
119   8095              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
120   8095              ; The aperture C000h-FFFFh is switched with port 3DFh.
121   8095              ; -------------------------------------------------------------------------
122   8095              Fill640x480x16:
123   8095 AF                   XOR     A
124   8096 32 76 83             LD      (CurrentBank),A
125   8099
126   8099              FillBankLoop:
127   8099 3A 76 83             LD      A,(CurrentBank)
128   809C 01 DF 03             LD      BC,$03DF
129   809F ED 79                OUT     (C),A
130   80A1
131   80A1 21 00 C0             LD      HL,$C000
132   80A4 11 3C 85             LD      DE,ColorPattern
133   80A7 3A 76 83             LD      A,(CurrentBank)
134   80AA FE 25                CP      37
135   80AC 28 05                JR      Z,FillLastHalfBank
136   80AE 01 00 40             LD      BC,$4000
137   80B1 18 03                JR      FillBankBytes
138   80B3
139   80B3              FillLastHalfBank:
140   80B3 01 00 20             LD      BC,$2000
141   80B6
142   80B6              FillBankBytes:
143   80B6 1A                   LD      A,(DE)
144   80B7 13                   INC     DE
145   80B8 77                   LD      (HL),A
146   80B9 23                   INC     HL
147   80BA
148   80BA                      ; Repeat the 128-byte RGB565 colour-bar sequence.
149   80BA F5                   PUSH    AF
150   80BB 7A                   LD      A,D
151   80BC FE 85                CP      HIGH ColorPatternEnd
152   80BE 20 08                JR      NZ,PatternPointerReady
153   80C0 7B                   LD      A,E
154   80C1 FE BC                CP      LOW ColorPatternEnd
155   80C3 20 03                JR      NZ,PatternPointerReady
156   80C5 11 3C 85             LD      DE,ColorPattern
157   80C8              PatternPointerReady:
158   80C8 F1                   POP     AF
159   80C9
160   80C9 0B                   DEC     BC
161   80CA 78                   LD      A,B
162   80CB B1                   OR      C
163   80CC 20 E8                JR      NZ,FillBankBytes
164   80CE
165   80CE 3A 76 83             LD      A,(CurrentBank)
166   80D1 3C                   INC     A
167   80D2 32 76 83             LD      (CurrentBank),A
168   80D5 FE 26                CP      38
169   80D7 20 C0                JR      NZ,FillBankLoop
170   80D9 C9                   RET
171   80DA
172   80DA              ; -------------------------------------------------------------------------
173   80DA              ; Readback checks:
174   80DA              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
175   80DA              ; bank 37 starts at linear offset 37*4000h = 5E000h.
176   80DA              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
177   80DA              ; Return A=0 on success, A=1 on mismatch.
178   80DA              ; -------------------------------------------------------------------------
179   80DA              VerifyFramebuffer:
180   80DA AF                   XOR     A
181   80DB 01 DF 03             LD      BC,$03DF
182   80DE ED 79                OUT     (C),A
183   80E0
184   80E0 21 00 C0             LD      HL,$C000
185   80E3                      ; First eight pixels are black: bytes 0..15 must be zero.
186   80E3 7E                   LD      A,(HL)
187   80E4 B7                   OR      A
188   80E5 20 23                JR      NZ,VerifyFailed
189   80E7 23                   INC     HL
190   80E8 7E                   LD      A,(HL)
191   80E9 B7                   OR      A
192   80EA 20 1E                JR      NZ,VerifyFailed
193   80EC
194   80EC                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
195   80EC 21 10 C0             LD      HL,$C010
196   80EF 7E                   LD      A,(HL)
197   80F0 FE 1F                CP      $1F
198   80F2 20 16                JR      NZ,VerifyFailed
199   80F4 23                   INC     HL
200   80F5 7E                   LD      A,(HL)
201   80F6 B7                   OR      A
202   80F7 20 11                JR      NZ,VerifyFailed
203   80F9
204   80F9 3E 25                LD      A,37
205   80FB 01 DF 03             LD      BC,$03DF
206   80FE ED 79                OUT     (C),A
207   8100 21 FF DF             LD      HL,$DFFF
208   8103 7E                   LD      A,(HL)
209   8104 FE FF                CP      $FF
210   8106 20 02                JR      NZ,VerifyFailed
211   8108
212   8108 AF                   XOR     A
213   8109 C9                   RET
214   810A
215   810A              VerifyFailed:
216   810A 3E 01                LD      A,1
217   810C C9                   RET
218   810D
219   810D
220   810D              ; -------------------------------------------------------------------------
221   810D              ; Sweep every packed-pixel mode accepted by the Project131 1 MiB adapter.
222   810D              ; Supported combinations are taken from docs/ISA_VGA_Adapter.md.
223   810D              ; Each mode is selected, the entire 1 MiB aperture is written, then held
224   810D              ; briefly so the VGA window can be inspected before advancing.
225   810D              ; -------------------------------------------------------------------------
226   810D              RunPackedModeSweep:
227   810D 21 8E 86             LD      HL,MsgSweepStart
228   8110 CD 6E 83             CALL    DebugPrint
229   8113 21 9F 83             LD      HL,PackedModeTable
230   8116 22 77 83             LD      (ModeTablePtr),HL
231   8119 21 E0 83             LD      HL,ModeLabelTable
232   811C 22 79 83             LD      (ModeLabelPtr),HL
233   811F 3E 0D                LD      A,13
234   8121 32 7C 83             LD      (ModeCount),A
235   8124 3E 01                LD      A,1
236   8126 32 7B 83             LD      (ModeIndex),A
237   8129
238   8129              PackedModeNext:
239   8129 2A 77 83             LD      HL,(ModeTablePtr)
240   812C 7E                   LD      A,(HL)
241   812D 23                   INC     HL
242   812E 32 7D 83             LD      (ModeXLo),A
243   8131 7E                   LD      A,(HL)
244   8132 23                   INC     HL
245   8133 32 7E 83             LD      (ModeXHi),A
246   8136 7E                   LD      A,(HL)
247   8137 23                   INC     HL
248   8138 32 7F 83             LD      (ModeYLo),A
249   813B 7E                   LD      A,(HL)
250   813C 23                   INC     HL
251   813D 32 80 83             LD      (ModeYHi),A
252   8140 7E                   LD      A,(HL)
253   8141 23                   INC     HL
254   8142 32 81 83             LD      (ModeBpp),A
255   8145 22 77 83             LD      (ModeTablePtr),HL
256   8148
257   8148 3E 00                LD      A,0
258   814A 3A 7D 83             LD      A,(ModeXLo)
259   814D 5F                   LD      E,A
260   814E CD 8B 80             CALL    WriteVgaRegister
261   8151 3E 01                LD      A,1
262   8153 3A 7E 83             LD      A,(ModeXHi)
263   8156 5F                   LD      E,A
264   8157 CD 8B 80             CALL    WriteVgaRegister
265   815A 3E 02                LD      A,2
266   815C 3A 7F 83             LD      A,(ModeYLo)
267   815F 5F                   LD      E,A
268   8160 CD 8B 80             CALL    WriteVgaRegister
269   8163 3E 03                LD      A,3
270   8165 3A 80 83             LD      A,(ModeYHi)
271   8168 5F                   LD      E,A
272   8169 CD 8B 80             CALL    WriteVgaRegister
273   816C 3E 04                LD      A,4
274   816E 3A 81 83             LD      A,(ModeBpp)
275   8171 5F                   LD      E,A
276   8172 CD 8B 80             CALL    WriteVgaRegister
277   8175 3E 05                LD      A,5
278   8177 1E 01                LD      E,1
279   8179 CD 8B 80             CALL    WriteVgaRegister
280   817C
281   817C 21 AD 86             LD      HL,MsgModePrefix
282   817F CD 6E 83             CALL    DebugPrint
283   8182 3A 7E 83             LD      A,(ModeXHi)
284   8185 CD 07 83             CALL    DebugHexByte
285   8188 3A 7D 83             LD      A,(ModeXLo)
286   818B CD 07 83             CALL    DebugHexByte
287   818E 3E 78                LD      A,'x'
288   8190 D3 EF                OUT     ($EF),A
289   8192 3A 80 83             LD      A,(ModeYHi)
290   8195 CD 07 83             CALL    DebugHexByte
291   8198 3A 7F 83             LD      A,(ModeYLo)
292   819B CD 07 83             CALL    DebugHexByte
293   819E 3E 20                LD      A,' '
294   81A0 D3 EF                OUT     ($EF),A
295   81A2 3A 81 83             LD      A,(ModeBpp)
296   81A5 CD 07 83             CALL    DebugHexByte
297   81A8 21 B3 86             LD      HL,MsgBppSuffix
298   81AB CD 6E 83             CALL    DebugPrint
