# file opened: vga_test.asm
  1   0000              ; =========================================================================
  2   0000              ; PROJECT132 — ATM TURBO 2+ VGA ADAPTER TEST
  3   0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
  4   0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
  5   0000              ;
  6   0000              ; Test:
  7   0000              ;   - unlock ATM shadow ports through TR-DOS ROM
  8   0000              ;   - enable VGA software mode + 16 KiB aperture
  9   0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
 10   0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
 11   0000              ;   - read back bytes from bank 0 and the last framebuffer bank
 12   0000              ;   - report results on port EF (spectrum_out.txt)
 13   0000              ;
 14   0000              ; Expected image: eight-colour RGB565 vertical bars.
 15   0000              ; =========================================================================
 16   0000
 17   0000                      DEVICE ZXSPECTRUM128
 18   0000                      EMPTYTRD "vga_test.TRD"
 19   0000
 20   0000                      ORG     $8000
 21   8000
 22   8000              VgaTestEntry:
 23   8000 F3                   DI
 24   8001 31 FF BF             LD      SP,$BFFF
 25   8004
 26   8004                      ; ROM PRINT-OUT/CLS need the normal Spectrum interrupt environment.
 27   8004 FB                   EI
 28   8005 CD 39 83             CALL    SpectrumShowStartup
 29   8008
 30   8008 21 07 88             LD      HL,MsgBuild
 31   800B CD ED 83             CALL    DebugPrint
 32   800E 21 1E 88             LD      HL,MsgStart
 33   8011 CD ED 83             CALL    DebugPrint
 34   8014
 35   8014 CD 84 80             CALL    OpenATMShadowPorts
 36   8017
 37   8017 21 3B 88             LD      HL,MsgAdapterInit
 38   801A CD ED 83             CALL    DebugPrint
 39   801D
 40   801D                      ; The initial framebuffer test is also identified on the Spectrum screen.
 41   801D CD 49 83             CALL    SpectrumShowInitialMode
 42   8020
 43   8020                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
 44   8020 01 DE 03             LD      BC,$03DE
 45   8023 3E 03                LD      A,$03
 46   8025 ED 79                OUT     (C),A
 47   8027
 48   8027                      ; Configure packed-pixel 640x480 RGB565:
 49   8027                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
 50   8027 3E 00                LD      A,0
 51   8029 1E 80                LD      E,$80
 52   802B CD 95 80             CALL    WriteVgaRegister
 53   802E 3E 01                LD      A,1
 54   8030 1E 02                LD      E,$02
 55   8032 CD 95 80             CALL    WriteVgaRegister
 56   8035 3E 02                LD      A,2
 57   8037 1E E0                LD      E,$E0
 58   8039 CD 95 80             CALL    WriteVgaRegister
 59   803C 3E 03                LD      A,3
 60   803E 1E 01                LD      E,$01
 61   8040 CD 95 80             CALL    WriteVgaRegister
 62   8043 3E 04                LD      A,4
 63   8045 1E 10                LD      E,16
 64   8047 CD 95 80             CALL    WriteVgaRegister
 65   804A 3E 05                LD      A,5
 66   804C 1E 01                LD      E,1
 67   804E CD 95 80             CALL    WriteVgaRegister
 68   8051
 69   8051 21 52 88             LD      HL,MsgModeSet
 70   8054 CD ED 83             CALL    DebugPrint
 71   8057
 72   8057 CD 9F 80             CALL    Fill640x480x16
 73   805A
 74   805A 21 6C 88             LD      HL,MsgFrameWritten
 75   805D CD ED 83             CALL    DebugPrint
 76   8060 CD 65 83             CALL    SpectrumShowInitialWriteComplete
 77   8063
 78   8063 CD E4 80             CALL    VerifyFramebuffer
 79   8066 B7                   OR      A
 80   8067 20 12                JR      NZ,VgaTestFailed
 81   8069
 82   8069 21 88 88             LD      HL,MsgReadbackPass
 83   806C CD ED 83             CALL    DebugPrint
 84   806F
 85   806F CD 17 81             CALL    RunPackedModeSweep
 86   8072
 87   8072 21 B2 88             LD      HL,MsgReady
 88   8075 CD ED 83             CALL    DebugPrint
 89   8078
 90   8078              VgaTestIdle:
 91   8078 76                   HALT
 92   8079 18 FD                JR      VgaTestIdle
 93   807B
 94   807B              VgaTestFailed:
 95   807B 21 9D 88             LD      HL,MsgReadbackFail
 96   807E CD ED 83             CALL    DebugPrint
 97   8081              VgaTestFailedIdle:
 98   8081 76                   HALT
 99   8082 18 FD                JR      VgaTestFailedIdle
