383   8236              ; -------------------------------------------------------------------------
384   8236              ; Draw "P132 VGA TEST" with the Spectrum ROM character set.
385   8236              ; The standard 8x8 ROM font starts at 3D00h (character 32).
386   8236              ; Draws one 104-pixel line at the top of bank 0. The chosen modes keep
387   8236              ; the complete 8 scanlines inside the first 16 KiB aperture bank.
388   8236              ; -------------------------------------------------------------------------
389   8236              DrawSpectrumBanner:
390   8236                      ; Select framebuffer bank zero.
391   8236 AF                   XOR     A
392   8237 01 DF 03             LD      BC,$03DF
393   823A ED 79                OUT     (C),A
394   823C
395   823C                      ; Bytes per pixel: ceil(BPP/8).
396   823C 3A 1A 84             LD      A,(ModeBpp)
397   823F FE 08                CP      8
398   8241 3E 01                LD      A,1
399   8243 28 18                JR      Z,DrawBytesReady
400   8245 3A 1A 84             LD      A,(ModeBpp)
401   8248 FE 10                CP      16
402   824A 3E 02                LD      A,2
403   824C 38 0F                JR      C,DrawBytesReady
404   824E 28 0D                JR      Z,DrawBytesReady
405   8250 3A 1A 84             LD      A,(ModeBpp)
406   8253 FE 18                CP      24
407   8255 3E 03                LD      A,3
408   8257 38 04                JR      C,DrawBytesReady
409   8259 28 02                JR      Z,DrawBytesReady
410   825B 3E 04                LD      A,4
411   825D              DrawBytesReady:
412   825D 32 1B 84             LD      (DrawBytes),A
413   8260
414   8260                      ; Calculate pitch = X resolution * bytes per pixel.
415   8260 3A 16 84             LD      A,(ModeXLo)
416   8263 6F                   LD      L,A
417   8264 3A 17 84             LD      A,(ModeXHi)
418   8267 67                   LD      H,A
419   8268 EB                   EX      DE,HL
420   8269 21 00 00             LD      HL,0
421   826C 3A 1B 84             LD      A,(DrawBytes)
422   826F              DrawPitchLoop:
423   826F 19                   ADD     HL,DE
424   8270 3D                   DEC     A
425   8271 20 FC                JR      NZ,DrawPitchLoop
426   8273 22 20 84             LD      (DrawPitch),HL
427   8276
428   8276 AF                   XOR     A
429   8277 32 1C 84             LD      (DrawRow),A
430   827A 32 22 84             LD      (DrawRowBase),A
431   827D 32 23 84             LD      (DrawRowBase+1),A
432   8280
433   8280              DrawBannerRow:
434   8280                      ; Start this scanline at C000h + row * pitch.
435   8280 2A 22 84             LD      HL,(DrawRowBase)
436   8283 11 00 C0             LD      DE,$C000
437   8286 19                   ADD     HL,DE
438   8287 22 24 84             LD      (DrawPixelPtr),HL
439   828A 21 11 83             LD      HL,DrawBannerText
440   828D 22 26 84             LD      (DrawStringPtr),HL
441   8290
442   8290              DrawBannerChar:
443   8290 2A 26 84             LD      HL,(DrawStringPtr)
444   8293 7E                   LD      A,(HL)
445   8294 B7                   OR      A
446   8295 28 3E                JR      Z,DrawBannerRowDone
447   8297 23                   INC     HL
448   8298 22 26 84             LD      (DrawStringPtr),HL
449   829B
450   829B                      ; Font address = 3D00h + (ASCII - 20h) * 8 + scanline.
451   829B D6 20                SUB     32
452   829D 6F                   LD      L,A
453   829E 26 00                LD      H,0
454   82A0 29                   ADD     HL,HL
455   82A1 29                   ADD     HL,HL
456   82A2 29                   ADD     HL,HL
457   82A3 11 00 3D             LD      DE,$3D00
458   82A6 19                   ADD     HL,DE
459   82A7 3A 1C 84             LD      A,(DrawRow)
460   82AA 5F                   LD      E,A
461   82AB 16 00                LD      D,0
462   82AD 19                   ADD     HL,DE
463   82AE 7E                   LD      A,(HL)
464   82AF 32 1E 84             LD      (DrawGlyphBits),A
465   82B2 3E 08                LD      A,8
466   82B4 32 1D 84             LD      (DrawPixelCount),A
467   82B7
468   82B7              DrawBannerPixel:
469   82B7 3A 1E 84             LD      A,(DrawGlyphBits)
470   82BA 07                   RLCA
471   82BB 32 1E 84             LD      (DrawGlyphBits),A
472   82BE 3E 00                LD      A,0
473   82C0 30 02                JR      NC,DrawBannerPixelInkReady
474   82C2 3E 01                LD      A,1
475   82C4              DrawBannerPixelInkReady:
476   82C4 32 1F 84             LD      (DrawInk),A
477   82C7 CD EC 82             CALL    DrawBannerPutPixel
478   82CA 3A 1D 84             LD      A,(DrawPixelCount)
479   82CD 3D                   DEC     A
480   82CE 32 1D 84             LD      (DrawPixelCount),A
481   82D1 20 E4                JR      NZ,DrawBannerPixel
482   82D3 18 BB                JR      DrawBannerChar
483   82D5
484   82D5              DrawBannerRowDone:
485   82D5 2A 22 84             LD      HL,(DrawRowBase)
486   82D8 ED 5B 20 84          LD      DE,(DrawPitch)
487   82DC 19                   ADD     HL,DE
488   82DD 22 22 84             LD      (DrawRowBase),HL
489   82E0 3A 1C 84             LD      A,(DrawRow)
490   82E3 3C                   INC     A
491   82E4 32 1C 84             LD      (DrawRow),A
492   82E7 FE 08                CP      8
493   82E9 20 95                JR      NZ,DrawBannerRow
494   82EB C9                   RET
