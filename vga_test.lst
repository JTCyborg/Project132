441   8281 07                   RLCA
442   8282 32 14 83             LD      (DrawGlyphBits),A
443   8285 3E 00                LD      A,0
444   8287 30 02                JR      NC,DrawBannerPixelInkReady
445   8289 3E 01                LD      A,1
446   828B              DrawBannerPixelInkReady:
447   828B 32 15 83             LD      (DrawInk),A
448   828E CD B3 82             CALL    DrawBannerPutPixel
449   8291 3A 13 83             LD      A,(DrawPixelCount)
450   8294 3D                   DEC     A
451   8295 32 13 83             LD      (DrawPixelCount),A
452   8298 20 E4                JR      NZ,DrawBannerPixel
453   829A 18 BB                JR      DrawBannerChar
