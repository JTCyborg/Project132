169   80D7              ; -------------------------------------------------------------------------
170   80D7              ; Readback checks:
171   80D7              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
172   80D7              ; bank 37 starts at linear offset 37*4000h = 5E000h.
173   80D7              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
174   80D7              ; Return A=0 on success, A=1 on mismatch.
175   80D7              ; -------------------------------------------------------------------------
