349   8205 78                   LD      A,B
350   8206 B1                   OR      C
351   8207 20 EA                JR      NZ,ModeFillByte
352   8209 3A 76 83             LD      A,(CurrentBank)
353   820C 3C                   INC     A
354   820D 32 76 83             LD      (CurrentBank),A
355   8210 FE 40                CP      64
356   8212 20 CE                JR      NZ,ModeFillBank
357   8214 C9                   RET
358   8215
359   8215              ModeHoldDelay:
360   8215 11 FF FF             LD      DE,$FFFF
361   8218              ModeHoldLoop:
362   8218 1B                   DEC     DE
363   8219 7A                   LD      A,D
364   821A B3                   OR      E
365   821B 20 FB                JR      NZ,ModeHoldLoop
366   821D C9                   RET
