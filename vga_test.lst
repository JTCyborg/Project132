502   82F2 23                   INC     HL
503   82F3 10 FC                DJNZ    DrawBannerPutPixelByte
504   82F5 22 8B 83             LD      (DrawPixelPtr),HL
505   82F8 C9                   RET
506   82F9
507   82F9              DrawBannerText:
508   82F9 50 31 33 32          DEFM    "P132 VGA TEST",0
508   82FD 20 56 47 41
508   8301 20 54 45 53
508   8305 54 00
509   8307
510   8307              DebugHexByte:
