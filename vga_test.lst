496   82EC              ; Write one foreground/background pixel and advance the linear pointer.
497   82EC              DrawBannerPutPixel:
498   82EC 2A 24 84             LD      HL,(DrawPixelPtr)
499   82EF 3A 1F 84             LD      A,(DrawInk)
500   82F2 B7                   OR      A
501   82F3 28 0D                JR      Z,DrawBannerBackground
502   82F5 3A 1A 84             LD      A,(ModeBpp)
503   82F8 FE 08                CP      8
504   82FA 3E FF                LD      A,$FF
505   82FC 20 05                JR      NZ,DrawBannerPixelValueReady
506   82FE 3E 0F                LD      A,$0F               ; EGA palette entry 15 = white.
507   8300 18 01                JR      DrawBannerPixelValueReady
508   8302              DrawBannerBackground:
509   8302 AF                   XOR     A
510   8303              DrawBannerPixelValueReady:
511   8303 4F                   LD      C,A
512   8304 3A 1B 84             LD      A,(DrawBytes)
513   8307 47                   LD      B,A
514   8308 79                   LD      A,C
