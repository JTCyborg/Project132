338   81F6              ; Fill 1 MiB with a repeating RGB/index-friendly byte pattern.
339   81F6              ; All 64 banks are written so the test covers the full VRAM aperture.
340   81F6              FillModeVRAM:
341   81F6 AF                   XOR     A
342   81F7 32 0F 84             LD      (CurrentBank),A
343   81FA              ModeFillBank:
344   81FA 3A 0F 84             LD      A,(CurrentBank)
345   81FD 01 DF 03             LD      BC,$03DF
346   8200 ED 79                OUT     (C),A
347   8202 21 00 C0             LD      HL,$C000
348   8205 11 28 84             LD      DE,ModePattern
349   8208 01 00 40             LD      BC,$4000
350   820B              ModeFillByte:
351   820B 1A                   LD      A,(DE)
352   820C 13                   INC     DE
353   820D 77                   LD      (HL),A
354   820E 23                   INC     HL
355   820F 7A                   LD      A,D
356   8210 FE 84                CP      HIGH ModePatternEnd
357   8212 20 08                JR      NZ,ModePatternReady
358   8214 7B                   LD      A,E
359   8215 FE 38                CP      LOW ModePatternEnd
360   8217 20 03                JR      NZ,ModePatternReady
361   8219 11 28 84             LD      DE,ModePattern
362   821C              ModePatternReady:
363   821C 0B                   DEC     BC
364   821D 78                   LD      A,B
365   821E B1                   OR      C
366   821F 20 EA                JR      NZ,ModeFillByte
367   8221 3A 0F 84             LD      A,(CurrentBank)
368   8224 3C                   INC     A
369   8225 32 0F 84             LD      (CurrentBank),A
370   8228 FE 40                CP      64
371   822A 20 CE                JR      NZ,ModeFillBank
372   822C C9                   RET
373   822D
374   822D              ModeHoldDelay:
375   822D 11 FF FF             LD      DE,$FFFF
376   8230              ModeHoldLoop:
