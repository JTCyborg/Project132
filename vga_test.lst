107   808F              ; -------------------------------------------------------------------------
108   808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
109   808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
110   808F              ; -------------------------------------------------------------------------
111   808F              OpenATMShadowPorts:
112   808F 01 9F 80             LD      BC,ShadowPortsOpened
113   8092 C5                   PUSH    BC
114   8093 01 53 2A             LD      BC,$2A53
115   8096 C5                   PUSH    BC
116   8097 01 77 01             LD      BC,$0177
117   809A 3E C3                LD      A,$C3
118   809C C3 2F 3D             JP      $3D2F
119   809F              ShadowPortsOpened:
120   809F C9                   RET
121   80A0
122   80A0              ; A = indexed VGA register, E = value.
123   80A0              WriteVgaRegister:
124   80A0 01 E0 03             LD      BC,$03E0
125   80A3 ED 79                OUT     (C),A
126   80A5 7B                   LD      A,E
127   80A6 0C                   INC     C
128   80A7 ED 79                OUT     (C),A
129   80A9 C9                   RET
130   80AA
131   80AA              ; -------------------------------------------------------------------------
132   80AA              ; Fill the 640x480x16 framebuffer.
133   80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
134   80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
135   80AA              ; -------------------------------------------------------------------------
136   80AA              Fill640x480x16:
137   80AA AF                   XOR     A
138   80AB 32 0F 84             LD      (CurrentBank),A
139   80AE
140   80AE              FillBankLoop:
141   80AE 3A 0F 84             LD      A,(CurrentBank)
142   80B1 01 DF 03             LD      BC,$03DF
143   80B4 ED 79                OUT     (C),A
144   80B6
145   80B6 21 00 C0             LD      HL,$C000
146   80B9 11 A1 87             LD      DE,ColorPattern
147   80BC 3A 0F 84             LD      A,(CurrentBank)
148   80BF FE 25                CP      37
149   80C1 28 05                JR      Z,FillLastHalfBank
150   80C3 01 00 40             LD      BC,$4000
151   80C6 18 03                JR      FillBankBytes
152   80C8
153   80C8              FillLastHalfBank:
154   80C8 01 00 20             LD      BC,$2000
155   80CB
156   80CB              FillBankBytes:
157   80CB 1A                   LD      A,(DE)
158   80CC 13                   INC     DE
159   80CD 77                   LD      (HL),A
160   80CE 23                   INC     HL
161   80CF
162   80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
163   80CF F5                   PUSH    AF
164   80D0 7A                   LD      A,D
165   80D1 FE 88                CP      HIGH ColorPatternEnd
166   80D3 20 08                JR      NZ,PatternPointerReady
167   80D5 7B                   LD      A,E
168   80D6 FE 21                CP      LOW ColorPatternEnd
169   80D8 20 03                JR      NZ,PatternPointerReady
170   80DA 11 A1 87             LD      DE,ColorPattern
171   80DD              PatternPointerReady:
172   80DD F1                   POP     AF
173   80DE
174   80DE 0B                   DEC     BC
175   80DF 78                   LD      A,B
176   80E0 B1                   OR      C
177   80E1 20 E8                JR      NZ,FillBankBytes
178   80E3
179   80E3 3A 0F 84             LD      A,(CurrentBank)
180   80E6 3C                   INC     A
181   80E7 32 0F 84             LD      (CurrentBank),A
182   80EA FE 26                CP      38
183   80EC 20 C0                JR      NZ,FillBankLoop
184   80EE C9                   RET
185   80EF
186   80EF              ; -------------------------------------------------------------------------
187   80EF              ; Readback checks:
188   80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
189   80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
190   80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
191   80EF              ; Return A=0 on success, A=1 on mismatch.
192   80EF              ; -------------------------------------------------------------------------
193   80EF              VerifyFramebuffer:
194   80EF AF                   XOR     A
195   80F0 01 DF 03             LD      BC,$03DF
196   80F3 ED 79                OUT     (C),A
197   80F5
198   80F5 21 00 C0             LD      HL,$C000
199   80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
200   80F8 7E                   LD      A,(HL)
201   80F9 B7                   OR      A
202   80FA 20 23                JR      NZ,VerifyFailed
203   80FC 23                   INC     HL
204   80FD 7E                   LD      A,(HL)
205   80FE B7                   OR      A
206   80FF 20 1E                JR      NZ,VerifyFailed
207   8101
208   8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
209   8101 21 10 C0             LD      HL,$C010
210   8104 7E                   LD      A,(HL)
211   8105 FE 1F                CP      $1F
212   8107 20 16                JR      NZ,VerifyFailed
213   8109 23                   INC     HL
214   810A 7E                   LD      A,(HL)
215   810B B7                   OR      A
216   810C 20 11                JR      NZ,VerifyFailed
217   810E
218   810E 3E 25                LD      A,37
219   8110 01 DF 03             LD      BC,$03DF
220   8113 ED 79                OUT     (C),A
221   8115 21 FF DF             LD      HL,$DFFF
222   8118 7E                   LD      A,(HL)
223   8119 FE FF                CP      $FF
224   811B 20 02                JR      NZ,VerifyFailed
225   811D
226   811D AF                   XOR     A
227   811E C9                   RET
228   811F
229   811F              VerifyFailed:
230   811F 3E 01                LD      A,1
231   8121 C9                   RET
232   8122
233   8122
234   8122              ; -------------------------------------------------------------------------
235   8122              ; Sweep every packed-pixel mode accepted by the Project131 1 MiB adapter.
236   8122              ; Supported combinations are taken from docs/ISA_VGA_Adapter.md.
237   8122              ; Each mode is selected, the entire 1 MiB aperture is written, then held
238   8122              ; briefly so the VGA window can be inspected before advancing.
239   8122              ; -------------------------------------------------------------------------
240   8122              RunPackedModeSweep:
241   8122 21 F3 88             LD      HL,MsgSweepStart
242   8125 CD 07 84             CALL    DebugPrint
243   8128 21 38 84             LD      HL,PackedModeTable
244   812B 22 10 84             LD      (ModeTablePtr),HL
245   812E 21 79 84             LD      HL,ModeLabelTable
246   8131 22 12 84             LD      (ModeLabelPtr),HL
247   8134 3E 0D                LD      A,13
248   8136 32 15 84             LD      (ModeCount),A
249   8139 3E 01                LD      A,1
250   813B 32 14 84             LD      (ModeIndex),A
251   813E
252   813E              PackedModeNext:
253   813E 2A 10 84             LD      HL,(ModeTablePtr)
254   8141 7E                   LD      A,(HL)
255   8142 23                   INC     HL
256   8143 32 16 84             LD      (ModeXLo),A
257   8146 7E                   LD      A,(HL)
258   8147 23                   INC     HL
259   8148 32 17 84             LD      (ModeXHi),A
260   814B 7E                   LD      A,(HL)
261   814C 23                   INC     HL
262   814D 32 18 84             LD      (ModeYLo),A
263   8150 7E                   LD      A,(HL)
264   8151 23                   INC     HL
265   8152 32 19 84             LD      (ModeYHi),A
266   8155 7E                   LD      A,(HL)
267   8156 23                   INC     HL
268   8157 32 1A 84             LD      (ModeBpp),A
269   815A 22 10 84             LD      (ModeTablePtr),HL
270   815D
271   815D 3A 16 84             LD      A,(ModeXLo)
272   8160 5F                   LD      E,A
273   8161 3E 00                LD      A,0
274   8163 CD A0 80             CALL    WriteVgaRegister
275   8166 3A 17 84             LD      A,(ModeXHi)
276   8169 5F                   LD      E,A
277   816A 3E 01                LD      A,1
278   816C CD A0 80             CALL    WriteVgaRegister
279   816F 3A 18 84             LD      A,(ModeYLo)
280   8172 5F                   LD      E,A
281   8173 3E 02                LD      A,2
282   8175 CD A0 80             CALL    WriteVgaRegister
283   8178 3A 19 84             LD      A,(ModeYHi)
284   817B 5F                   LD      E,A
285   817C 3E 03                LD      A,3
286   817E CD A0 80             CALL    WriteVgaRegister
287   8181 3A 1A 84             LD      A,(ModeBpp)
288   8184 5F                   LD      E,A
289   8185 3E 04                LD      A,4
290   8187 CD A0 80             CALL    WriteVgaRegister
291   818A 3E 05                LD      A,5
292   818C 1E 01                LD      E,1
293   818E CD A0 80             CALL    WriteVgaRegister
294   8191
295   8191 21 12 89             LD      HL,MsgModePrefix
296   8194 CD 07 84             CALL    DebugPrint
297   8197 3A 17 84             LD      A,(ModeXHi)
298   819A CD 1F 83             CALL    DebugHexByte
299   819D 3A 16 84             LD      A,(ModeXLo)
300   81A0 CD 1F 83             CALL    DebugHexByte
301   81A3 3E 78                LD      A,'x'
302   81A5 D3 EF                OUT     ($EF),A
303   81A7 3A 19 84             LD      A,(ModeYHi)
304   81AA CD 1F 83             CALL    DebugHexByte
305   81AD 3A 18 84             LD      A,(ModeYLo)
306   81B0 CD 1F 83             CALL    DebugHexByte
307   81B3 3E 20                LD      A,' '
308   81B5 D3 EF                OUT     ($EF),A
309   81B7 3A 1A 84             LD      A,(ModeBpp)
310   81BA CD 1F 83             CALL    DebugHexByte
311   81BD 21 18 89             LD      HL,MsgBppSuffix
312   81C0 CD 07 84             CALL    DebugPrint
313   81C3
314   81C3                      ; Show the selected mode BEFORE the long 1 MiB VRAM fill.
315   81C3 CD 9B 83             CALL    SpectrumShowMode
316   81C6 CD F6 81             CALL    FillModeVRAM
317   81C9 CD C7 83             CALL    SpectrumShowWriteComplete
318   81CC                      ; Do not change mode until the user presses and releases SPACE.
319   81CC CD F7 83             CALL    WaitSpace
320   81CF
321   81CF 3A 14 84             LD      A,(ModeIndex)
322   81D2 3C                   INC     A
323   81D3 32 14 84             LD      (ModeIndex),A
324   81D6
325   81D6 3A 15 84             LD      A,(ModeCount)
326   81D9 3D                   DEC     A
327   81DA 32 15 84             LD      (ModeCount),A
