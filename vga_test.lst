309   81BD              ; Fill 1 MiB with a repeating RGB/index-friendly byte pattern.
310   81BD              ; All 64 banks are written so the test covers the full VRAM aperture.
311   81BD              FillModeVRAM:
312   81BD AF                   XOR     A
313   81BE 32 08 83             LD      (CurrentBank),A
314   81C1              ModeFillBank:
315   81C1 3A 08 83             LD      A,(CurrentBank)
316   81C4 01 DF 03             LD      BC,$03DF
317   81C7 ED 79                OUT     (C),A
318   81C9 21 00 C0             LD      HL,$C000
319   81CC 11 1E 83             LD      DE,ModePattern
320   81CF 01 00 40             LD      BC,$4000
321   81D2              ModeFillByte:
322   81D2 1A                   LD      A,(DE)
323   81D3 13                   INC     DE
324   81D4 77                   LD      (HL),A
325   81D5 23                   INC     HL
326   81D6 7A                   LD      A,D
327   81D7 FE 83                CP      HIGH ModePatternEnd
328   81D9 20 08                JR      NZ,ModePatternReady
329   81DB 7B                   LD      A,E
330   81DC FE 2E                CP      LOW ModePatternEnd
331   81DE 20 03                JR      NZ,ModePatternReady
332   81E0 11 1E 83             LD      DE,ModePattern
333   81E3              ModePatternReady:
334   81E3 0B                   DEC     BC
335   81E4 78                   LD      A,B
336   81E5 B1                   OR      C
337   81E6 20 EA                JR      NZ,ModeFillByte
338   81E8 3A 08 83             LD      A,(CurrentBank)
339   81EB 3C                   INC     A
340   81EC 32 08 83             LD      (CurrentBank),A
341   81EF FE 40                CP      64
342   81F1 20 CE                JR      NZ,ModeFillBank
343   81F3 C9                   RET
344   81F4
345   81F4              ModeHoldDelay:
346   81F4 11 FF FF             LD      DE,$FFFF
347   81F7              ModeHoldLoop:
348   81F7 1B                   DEC     DE
349   81F8 7A                   LD      A,D
350   81F9 B3                   OR      E
351   81FA 20 FB                JR      NZ,ModeHoldLoop
352   81FC C9                   RET
