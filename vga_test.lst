# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT132 — ATM TURBO 2+ VGA ADAPTER TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004                      ; Follow Project112: unlock and select the standard Spectrum page
  27  8004                      ; before touching the screen bitmap directly.
  28  8004
  29  8004 21 F2 88             LD      HL,MsgBuild
  30  8007 CD D2 84             CALL    DebugPrint
  31  800A 21 09 89             LD      HL,MsgStart
  32  800D CD D2 84             CALL    DebugPrint
  33  8010
  34  8010 CD 8F 80             CALL    OpenATMShadowPorts
  35  8013
  36  8013                      ; Exact Project112 order: unlock shadow ports, then select page 5.
  37  8013 AF                   XOR     A
  38  8014 01 FD 7F             LD      BC,$7FFD
  39  8017 ED 79                OUT     (C),A
  40  8019
  41  8019 CD 0F 84             CALL    SpectrumShowStartup
  42  801C 21 51 8A             LD      HL,ScreenShadowReady
  43  801F CD 1F 84             CALL    SpectrumShowStatus
  44  8022
  45  8022 21 26 89             LD      HL,MsgAdapterInit
  46  8025 CD D2 84             CALL    DebugPrint
  47  8028
  48  8028                      ; The initial framebuffer test is also identified on the Spectrum screen.
  49  8028 CD 2E 84             CALL    SpectrumShowInitialMode
  50  802B
  51  802B                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  52  802B 01 DE 03             LD      BC,$03DE
  53  802E 3E 03                LD      A,$03
  54  8030 ED 79                OUT     (C),A
  55  8032
  56  8032                      ; Configure packed-pixel 640x480 RGB565:
  57  8032                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  58  8032 3E 00                LD      A,0
  59  8034 1E 80                LD      E,$80
  60  8036 CD A0 80             CALL    WriteVgaRegister
  61  8039 3E 01                LD      A,1
  62  803B 1E 02                LD      E,$02
  63  803D CD A0 80             CALL    WriteVgaRegister
  64  8040 3E 02                LD      A,2
  65  8042 1E E0                LD      E,$E0
  66  8044 CD A0 80             CALL    WriteVgaRegister
  67  8047 3E 03                LD      A,3
  68  8049 1E 01                LD      E,$01
  69  804B CD A0 80             CALL    WriteVgaRegister
  70  804E 3E 04                LD      A,4
  71  8050 1E 10                LD      E,16
  72  8052 CD A0 80             CALL    WriteVgaRegister
  73  8055 3E 05                LD      A,5
  74  8057 1E 01                LD      E,1
  75  8059 CD A0 80             CALL    WriteVgaRegister
  76  805C
  77  805C 21 3D 89             LD      HL,MsgModeSet
  78  805F CD D2 84             CALL    DebugPrint
  79  8062
  80  8062 CD AA 80             CALL    Fill640x480x16
  81  8065
  82  8065 21 57 89             LD      HL,MsgFrameWritten
  83  8068 CD D2 84             CALL    DebugPrint
  84  806B CD 4A 84             CALL    SpectrumShowInitialWriteComplete
  85  806E
  86  806E CD EF 80             CALL    VerifyFramebuffer
  87  8071 B7                   OR      A
  88  8072 20 12                JR      NZ,VgaTestFailed
  89  8074
  90  8074 21 73 89             LD      HL,MsgReadbackPass
  91  8077 CD D2 84             CALL    DebugPrint
  92  807A
  93  807A CD 22 81             CALL    RunPackedModeSweep
  94  807D
  95  807D 21 9D 89             LD      HL,MsgReady
  96  8080 CD D2 84             CALL    DebugPrint
  97  8083
  98  8083              VgaTestIdle:
  99  8083 76                   HALT
 100  8084 18 FD                JR      VgaTestIdle
 101  8086
 102  8086              VgaTestFailed:
 103  8086 21 88 89             LD      HL,MsgReadbackFail
 104  8089 CD D2 84             CALL    DebugPrint
 105  808C              VgaTestFailedIdle:
 106  808C 76                   HALT
 107  808D 18 FD                JR      VgaTestFailedIdle
 108  808F
 109  808F              ; -------------------------------------------------------------------------
 110  808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 111  808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 112  808F              ; -------------------------------------------------------------------------
 113  808F              OpenATMShadowPorts:
 114  808F 01 9F 80             LD      BC,ShadowPortsOpened
 115  8092 C5                   PUSH    BC
 116  8093 01 53 2A             LD      BC,$2A53
 117  8096 C5                   PUSH    BC
 118  8097 01 77 01             LD      BC,$0177
 119  809A 3E C3                LD      A,$C3
 120  809C C3 2F 3D             JP      $3D2F
 121  809F              ShadowPortsOpened:
 122  809F C9                   RET
 123  80A0
 124  80A0              ; A = indexed VGA register, E = value.
 125  80A0              WriteVgaRegister:
 126  80A0 01 E0 03             LD      BC,$03E0
 127  80A3 ED 79                OUT     (C),A
 128  80A5 7B                   LD      A,E
 129  80A6 0C                   INC     C
 130  80A7 ED 79                OUT     (C),A
 131  80A9 C9                   RET
 132  80AA
 133  80AA              ; -------------------------------------------------------------------------
 134  80AA              ; Fill the 640x480x16 framebuffer.
 135  80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 136  80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
 137  80AA              ; -------------------------------------------------------------------------
 138  80AA              Fill640x480x16:
 139  80AA AF                   XOR     A
 140  80AB 32 DA 84             LD      (CurrentBank),A
 141  80AE
 142  80AE              FillBankLoop:
 143  80AE 3A DA 84             LD      A,(CurrentBank)
 144  80B1 01 DF 03             LD      BC,$03DF
 145  80B4 ED 79                OUT     (C),A
 146  80B6
 147  80B6 21 00 C0             LD      HL,$C000
 148  80B9 11 72 88             LD      DE,ColorPattern
 149  80BC 3A DA 84             LD      A,(CurrentBank)
 150  80BF FE 25                CP      37
 151  80C1 28 05                JR      Z,FillLastHalfBank
 152  80C3 01 00 40             LD      BC,$4000
 153  80C6 18 03                JR      FillBankBytes
 154  80C8
 155  80C8              FillLastHalfBank:
 156  80C8 01 00 20             LD      BC,$2000
 157  80CB
 158  80CB              FillBankBytes:
 159  80CB 1A                   LD      A,(DE)
 160  80CC 13                   INC     DE
 161  80CD 77                   LD      (HL),A
 162  80CE 23                   INC     HL
 163  80CF
 164  80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 165  80CF F5                   PUSH    AF
 166  80D0 7A                   LD      A,D
 167  80D1 FE 88                CP      HIGH ColorPatternEnd
 168  80D3 20 08                JR      NZ,PatternPointerReady
 169  80D5 7B                   LD      A,E
 170  80D6 FE F2                CP      LOW ColorPatternEnd
 171  80D8 20 03                JR      NZ,PatternPointerReady
 172  80DA 11 72 88             LD      DE,ColorPattern
 173  80DD              PatternPointerReady:
 174  80DD F1                   POP     AF
 175  80DE
 176  80DE 0B                   DEC     BC
 177  80DF 78                   LD      A,B
 178  80E0 B1                   OR      C
 179  80E1 20 E8                JR      NZ,FillBankBytes
 180  80E3
 181  80E3 3A DA 84             LD      A,(CurrentBank)
 182  80E6 3C                   INC     A
 183  80E7 32 DA 84             LD      (CurrentBank),A
 184  80EA FE 26                CP      38
 185  80EC 20 C0                JR      NZ,FillBankLoop
 186  80EE C9                   RET
 187  80EF
 188  80EF              ; -------------------------------------------------------------------------
 189  80EF              ; Readback checks:
 190  80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 191  80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 192  80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 193  80EF              ; Return A=0 on success, A=1 on mismatch.
 194  80EF              ; -------------------------------------------------------------------------
 195  80EF              VerifyFramebuffer:
 196  80EF AF                   XOR     A
 197  80F0 01 DF 03             LD      BC,$03DF
 198  80F3 ED 79                OUT     (C),A
 199  80F5
 200  80F5 21 00 C0             LD      HL,$C000
 201  80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
 202  80F8 7E                   LD      A,(HL)
 203  80F9 B7                   OR      A
 204  80FA 20 23                JR      NZ,VerifyFailed
 205  80FC 23                   INC     HL
 206  80FD 7E                   LD      A,(HL)
 207  80FE B7                   OR      A
 208  80FF 20 1E                JR      NZ,VerifyFailed
 209  8101
 210  8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 211  8101 21 10 C0             LD      HL,$C010
 212  8104 7E                   LD      A,(HL)
 213  8105 FE 1F                CP      $1F
 214  8107 20 16                JR      NZ,VerifyFailed
 215  8109 23                   INC     HL
 216  810A 7E                   LD      A,(HL)
 217  810B B7                   OR      A
 218  810C 20 11                JR      NZ,VerifyFailed
 219  810E
 220  810E 3E 25                LD      A,37
 221  8110 01 DF 03             LD      BC,$03DF
 222  8113 ED 79                OUT     (C),A
 223  8115 21 FF DF             LD      HL,$DFFF
 224  8118 7E                   LD      A,(HL)
 225  8119 FE FF                CP      $FF
 226  811B 20 02                JR      NZ,VerifyFailed
 227  811D
 228  811D AF                   XOR     A
 229  811E C9                   RET
 230  811F
 231  811F              VerifyFailed:
 232  811F 3E 01                LD      A,1
 233  8121 C9                   RET
 234  8122
 235  8122
 236  8122              ; -------------------------------------------------------------------------
 237  8122              ; Sweep every packed-pixel mode accepted by the Project131 1 MiB adapter.
 238  8122              ; Supported combinations are taken from docs/ISA_VGA_Adapter.md.
 239  8122              ; Each mode is selected, the entire 1 MiB aperture is written, then held
 240  8122              ; briefly so the VGA window can be inspected before advancing.
 241  8122              ; -------------------------------------------------------------------------
 242  8122              RunPackedModeSweep:
 243  8122 21 C4 89             LD      HL,MsgSweepStart
 244  8125 CD D2 84             CALL    DebugPrint
 245  8128 21 09 85             LD      HL,PackedModeTable
 246  812B 22 DB 84             LD      (ModeTablePtr),HL
 247  812E 21 4A 85             LD      HL,ModeLabelTable
 248  8131 22 DD 84             LD      (ModeLabelPtr),HL
 249  8134 3E 0D                LD      A,13
 250  8136 32 E0 84             LD      (ModeCount),A
 251  8139 3E 01                LD      A,1
 252  813B 32 DF 84             LD      (ModeIndex),A
 253  813E
 254  813E              PackedModeNext:
 255  813E 2A DB 84             LD      HL,(ModeTablePtr)
 256  8141 7E                   LD      A,(HL)
 257  8142 23                   INC     HL
 258  8143 32 E1 84             LD      (ModeXLo),A
 259  8146 7E                   LD      A,(HL)
 260  8147 23                   INC     HL
 261  8148 32 E2 84             LD      (ModeXHi),A
 262  814B 7E                   LD      A,(HL)
 263  814C 23                   INC     HL
 264  814D 32 E3 84             LD      (ModeYLo),A
 265  8150 7E                   LD      A,(HL)
 266  8151 23                   INC     HL
 267  8152 32 E4 84             LD      (ModeYHi),A
 268  8155 7E                   LD      A,(HL)
 269  8156 23                   INC     HL
 270  8157 32 E5 84             LD      (ModeBpp),A
 271  815A 22 DB 84             LD      (ModeTablePtr),HL
 272  815D
 273  815D 3A E1 84             LD      A,(ModeXLo)
 274  8160 5F                   LD      E,A
 275  8161 3E 00                LD      A,0
 276  8163 CD A0 80             CALL    WriteVgaRegister
 277  8166 3A E2 84             LD      A,(ModeXHi)
 278  8169 5F                   LD      E,A
 279  816A 3E 01                LD      A,1
 280  816C CD A0 80             CALL    WriteVgaRegister
 281  816F 3A E3 84             LD      A,(ModeYLo)
 282  8172 5F                   LD      E,A
 283  8173 3E 02                LD      A,2
 284  8175 CD A0 80             CALL    WriteVgaRegister
 285  8178 3A E4 84             LD      A,(ModeYHi)
 286  817B 5F                   LD      E,A
 287  817C 3E 03                LD      A,3
 288  817E CD A0 80             CALL    WriteVgaRegister
 289  8181 3A E5 84             LD      A,(ModeBpp)
 290  8184 5F                   LD      E,A
 291  8185 3E 04                LD      A,4
 292  8187 CD A0 80             CALL    WriteVgaRegister
 293  818A 3E 05                LD      A,5
 294  818C 1E 01                LD      E,1
 295  818E CD A0 80             CALL    WriteVgaRegister
 296  8191
 297  8191 21 E3 89             LD      HL,MsgModePrefix
 298  8194 CD D2 84             CALL    DebugPrint
 299  8197 3A E2 84             LD      A,(ModeXHi)
 300  819A CD 1F 83             CALL    DebugHexByte
 301  819D 3A E1 84             LD      A,(ModeXLo)
 302  81A0 CD 1F 83             CALL    DebugHexByte
 303  81A3 3E 78                LD      A,'x'
 304  81A5 D3 EF                OUT     ($EF),A
 305  81A7 3A E4 84             LD      A,(ModeYHi)
 306  81AA CD 1F 83             CALL    DebugHexByte
 307  81AD 3A E3 84             LD      A,(ModeYLo)
 308  81B0 CD 1F 83             CALL    DebugHexByte
 309  81B3 3E 20                LD      A,' '
 310  81B5 D3 EF                OUT     ($EF),A
 311  81B7 3A E5 84             LD      A,(ModeBpp)
 312  81BA CD 1F 83             CALL    DebugHexByte
 313  81BD 21 E9 89             LD      HL,MsgBppSuffix
 314  81C0 CD D2 84             CALL    DebugPrint
 315  81C3
 316  81C3                      ; Show the selected mode BEFORE the long 1 MiB VRAM fill.
 317  81C3 CD 66 84             CALL    SpectrumShowMode
 318  81C6 CD F6 81             CALL    FillModeVRAM
 319  81C9 CD 92 84             CALL    SpectrumShowWriteComplete
 320  81CC                      ; Do not change mode until the user presses and releases SPACE.
 321  81CC CD C2 84             CALL    WaitSpace
 322  81CF
 323  81CF 3A DF 84             LD      A,(ModeIndex)
 324  81D2 3C                   INC     A
 325  81D3 32 DF 84             LD      (ModeIndex),A
 326  81D6
 327  81D6 3A E0 84             LD      A,(ModeCount)
 328  81D9 3D                   DEC     A
 329  81DA 32 E0 84             LD      (ModeCount),A
 330  81DD C2 3E 81             JP      NZ,PackedModeNext
 331  81E0 21 FC 89             LD      HL,MsgSweepDone
 332  81E3 CD D2 84             CALL    DebugPrint
 333  81E6 CD ED 83             CALL    SpectrumClear
 334  81E9 21 1A 8A             LD      HL,ScreenTitle
 335  81EC CD 39 83             CALL    SpectrumPrint
 336  81EF 21 4F 8B             LD      HL,ScreenAllDone
 337  81F2 CD 39 83             CALL    SpectrumPrint
 338  81F5 C9                   RET
 339  81F6
 340  81F6              ; Fill 1 MiB with a repeating RGB/index-friendly byte pattern.
 341  81F6              ; All 64 banks are written so the test covers the full VRAM aperture.
 342  81F6              FillModeVRAM:
 343  81F6 AF                   XOR     A
 344  81F7 32 DA 84             LD      (CurrentBank),A
 345  81FA              ModeFillBank:
 346  81FA 3A DA 84             LD      A,(CurrentBank)
 347  81FD 01 DF 03             LD      BC,$03DF
 348  8200 ED 79                OUT     (C),A
 349  8202 21 00 C0             LD      HL,$C000
 350  8205 11 F9 84             LD      DE,ModePattern
 351  8208 01 00 40             LD      BC,$4000
 352  820B              ModeFillByte:
 353  820B 1A                   LD      A,(DE)
 354  820C 13                   INC     DE
 355  820D 77                   LD      (HL),A
 356  820E 23                   INC     HL
 357  820F 7A                   LD      A,D
 358  8210 FE 85                CP      HIGH ModePatternEnd
 359  8212 20 08                JR      NZ,ModePatternReady
 360  8214 7B                   LD      A,E
 361  8215 FE 09                CP      LOW ModePatternEnd
 362  8217 20 03                JR      NZ,ModePatternReady
 363  8219 11 F9 84             LD      DE,ModePattern
 364  821C              ModePatternReady:
 365  821C 0B                   DEC     BC
 366  821D 78                   LD      A,B
 367  821E B1                   OR      C
 368  821F 20 EA                JR      NZ,ModeFillByte
 369  8221 3A DA 84             LD      A,(CurrentBank)
 370  8224 3C                   INC     A
 371  8225 32 DA 84             LD      (CurrentBank),A
 372  8228 FE 40                CP      64
 373  822A 20 CE                JR      NZ,ModeFillBank
 374  822C C9                   RET
 375  822D
 376  822D              ModeHoldDelay:
 377  822D 11 FF FF             LD      DE,$FFFF
 378  8230              ModeHoldLoop:
 379  8230 1B                   DEC     DE
 380  8231 7A                   LD      A,D
 381  8232 B3                   OR      E
 382  8233 20 FB                JR      NZ,ModeHoldLoop
 383  8235 C9                   RET
 384  8236
 385  8236              ; -------------------------------------------------------------------------
 386  8236              ; Draw "P132 VGA TEST" with the Spectrum ROM character set.
 387  8236              ; The standard 8x8 ROM font starts at 3D00h (character 32).
 388  8236              ; Draws one 104-pixel line at the top of bank 0. The chosen modes keep
 389  8236              ; the complete 8 scanlines inside the first 16 KiB aperture bank.
 390  8236              ; -------------------------------------------------------------------------
 391  8236              DrawSpectrumBanner:
 392  8236                      ; Select framebuffer bank zero.
 393  8236 AF                   XOR     A
 394  8237 01 DF 03             LD      BC,$03DF
 395  823A ED 79                OUT     (C),A
 396  823C
 397  823C                      ; Bytes per pixel: ceil(BPP/8).
 398  823C 3A E5 84             LD      A,(ModeBpp)
 399  823F FE 08                CP      8
 400  8241 3E 01                LD      A,1
 401  8243 28 18                JR      Z,DrawBytesReady
 402  8245 3A E5 84             LD      A,(ModeBpp)
 403  8248 FE 10                CP      16
 404  824A 3E 02                LD      A,2
 405  824C 38 0F                JR      C,DrawBytesReady
 406  824E 28 0D                JR      Z,DrawBytesReady
 407  8250 3A E5 84             LD      A,(ModeBpp)
 408  8253 FE 18                CP      24
 409  8255 3E 03                LD      A,3
 410  8257 38 04                JR      C,DrawBytesReady
 411  8259 28 02                JR      Z,DrawBytesReady
 412  825B 3E 04                LD      A,4
 413  825D              DrawBytesReady:
 414  825D 32 E6 84             LD      (DrawBytes),A
 415  8260
 416  8260                      ; Calculate pitch = X resolution * bytes per pixel.
 417  8260 3A E1 84             LD      A,(ModeXLo)
 418  8263 6F                   LD      L,A
 419  8264 3A E2 84             LD      A,(ModeXHi)
 420  8267 67                   LD      H,A
 421  8268 EB                   EX      DE,HL
 422  8269 21 00 00             LD      HL,0
 423  826C 3A E6 84             LD      A,(DrawBytes)
 424  826F              DrawPitchLoop:
 425  826F 19                   ADD     HL,DE
 426  8270 3D                   DEC     A
 427  8271 20 FC                JR      NZ,DrawPitchLoop
 428  8273 22 EB 84             LD      (DrawPitch),HL
 429  8276
 430  8276 AF                   XOR     A
 431  8277 32 E7 84             LD      (DrawRow),A
 432  827A 32 ED 84             LD      (DrawRowBase),A
 433  827D 32 EE 84             LD      (DrawRowBase+1),A
 434  8280
 435  8280              DrawBannerRow:
 436  8280                      ; Start this scanline at C000h + row * pitch.
 437  8280 2A ED 84             LD      HL,(DrawRowBase)
 438  8283 11 00 C0             LD      DE,$C000
 439  8286 19                   ADD     HL,DE
 440  8287 22 EF 84             LD      (DrawPixelPtr),HL
 441  828A 21 11 83             LD      HL,DrawBannerText
 442  828D 22 F1 84             LD      (DrawStringPtr),HL
 443  8290
 444  8290              DrawBannerChar:
 445  8290 2A F1 84             LD      HL,(DrawStringPtr)
 446  8293 7E                   LD      A,(HL)
 447  8294 B7                   OR      A
 448  8295 28 3E                JR      Z,DrawBannerRowDone
 449  8297 23                   INC     HL
 450  8298 22 F1 84             LD      (DrawStringPtr),HL
 451  829B
 452  829B                      ; Font address = 3D00h + (ASCII - 20h) * 8 + scanline.
 453  829B D6 20                SUB     32
 454  829D 6F                   LD      L,A
 455  829E 26 00                LD      H,0
 456  82A0 29                   ADD     HL,HL
 457  82A1 29                   ADD     HL,HL
 458  82A2 29                   ADD     HL,HL
 459  82A3 11 00 3D             LD      DE,$3D00
 460  82A6 19                   ADD     HL,DE
 461  82A7 3A E7 84             LD      A,(DrawRow)
 462  82AA 5F                   LD      E,A
 463  82AB 16 00                LD      D,0
 464  82AD 19                   ADD     HL,DE
 465  82AE 7E                   LD      A,(HL)
 466  82AF 32 E9 84             LD      (DrawGlyphBits),A
 467  82B2 3E 08                LD      A,8
 468  82B4 32 E8 84             LD      (DrawPixelCount),A
 469  82B7
 470  82B7              DrawBannerPixel:
 471  82B7 3A E9 84             LD      A,(DrawGlyphBits)
 472  82BA 07                   RLCA
 473  82BB 32 E9 84             LD      (DrawGlyphBits),A
 474  82BE 3E 00                LD      A,0
 475  82C0 30 02                JR      NC,DrawBannerPixelInkReady
 476  82C2 3E 01                LD      A,1
 477  82C4              DrawBannerPixelInkReady:
 478  82C4 32 EA 84             LD      (DrawInk),A
 479  82C7 CD EC 82             CALL    DrawBannerPutPixel
 480  82CA 3A E8 84             LD      A,(DrawPixelCount)
 481  82CD 3D                   DEC     A
 482  82CE 32 E8 84             LD      (DrawPixelCount),A
 483  82D1 20 E4                JR      NZ,DrawBannerPixel
 484  82D3 18 BB                JR      DrawBannerChar
 485  82D5
 486  82D5              DrawBannerRowDone:
 487  82D5 2A ED 84             LD      HL,(DrawRowBase)
 488  82D8 ED 5B EB 84          LD      DE,(DrawPitch)
 489  82DC 19                   ADD     HL,DE
 490  82DD 22 ED 84             LD      (DrawRowBase),HL
 491  82E0 3A E7 84             LD      A,(DrawRow)
 492  82E3 3C                   INC     A
 493  82E4 32 E7 84             LD      (DrawRow),A
 494  82E7 FE 08                CP      8
 495  82E9 20 95                JR      NZ,DrawBannerRow
 496  82EB C9                   RET
 497  82EC
 498  82EC              ; Write one foreground/background pixel and advance the linear pointer.
 499  82EC              DrawBannerPutPixel:
 500  82EC 2A EF 84             LD      HL,(DrawPixelPtr)
 501  82EF 3A EA 84             LD      A,(DrawInk)
 502  82F2 B7                   OR      A
 503  82F3 28 0D                JR      Z,DrawBannerBackground
 504  82F5 3A E5 84             LD      A,(ModeBpp)
 505  82F8 FE 08                CP      8
 506  82FA 3E FF                LD      A,$FF
 507  82FC 20 05                JR      NZ,DrawBannerPixelValueReady
 508  82FE 3E 0F                LD      A,$0F               ; EGA palette entry 15 = white.
 509  8300 18 01                JR      DrawBannerPixelValueReady
 510  8302              DrawBannerBackground:
 511  8302 AF                   XOR     A
 512  8303              DrawBannerPixelValueReady:
 513  8303 4F                   LD      C,A
 514  8304 3A E6 84             LD      A,(DrawBytes)
 515  8307 47                   LD      B,A
 516  8308 79                   LD      A,C
 517  8309              DrawBannerPutPixelByte:
 518  8309 77                   LD      (HL),A
 519  830A 23                   INC     HL
 520  830B 10 FC                DJNZ    DrawBannerPutPixelByte
 521  830D 22 EF 84             LD      (DrawPixelPtr),HL
 522  8310 C9                   RET
 523  8311
 524  8311              DrawBannerText:
 525  8311 50 31 33 32          DEFM    "P132 VGA TEST",0
 525  8315 20 56 47 41
 525  8319 20 54 45 53
 525  831D 54 00
 526  831F
 527  831F              DebugHexByte:
 528  831F F5                   PUSH    AF
 529  8320 0F                   RRCA
 530  8321 0F                   RRCA
 531  8322 0F                   RRCA
 532  8323 0F                   RRCA
 533  8324 CD 2C 83             CALL    DebugHexNibble
 534  8327 F1                   POP     AF
