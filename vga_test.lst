 71   805C B7                   OR      A
 72   805D 20 0F                JR      NZ,VgaTestFailed
 73   805F
 74   805F 21 18 82             LD      HL,MsgReadbackPass
 75   8062 CD 0E 81             CALL    DebugPrint
 76   8065 21 42 82             LD      HL,MsgReady
 77   8068 CD 0E 81             CALL    DebugPrint
 78   806B
