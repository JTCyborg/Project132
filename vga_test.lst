# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT132 — ATM TURBO 2+ VGA ADAPTER TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004                      ; Follow Project112: unlock and select the standard Spectrum page
  27  8004                      ; before touching the screen bitmap directly.
  28  8004
  29  8004 21 3C 8A             LD      HL,MsgBuild
  30  8007 CD FC 84             CALL    DebugPrint
  31  800A 21 53 8A             LD      HL,MsgStart
  32  800D CD FC 84             CALL    DebugPrint
  33  8010
  34  8010 CD 8F 80             CALL    OpenATMShadowPorts
  35  8013
  36  8013                      ; Exact Project112 order: unlock shadow ports, then select page 5.
  37  8013 AF                   XOR     A
  38  8014 01 FD 7F             LD      BC,$7FFD
  39  8017 ED 79                OUT     (C),A
  40  8019
  41  8019 CD 39 84             CALL    SpectrumShowStartup
  42  801C 21 9B 8B             LD      HL,ScreenShadowReady
  43  801F CD 49 84             CALL    SpectrumShowStatus
  44  8022
  45  8022 21 70 8A             LD      HL,MsgAdapterInit
  46  8025 CD FC 84             CALL    DebugPrint
  47  8028
  48  8028                      ; The initial framebuffer test is also identified on the Spectrum screen.
  49  8028 CD 58 84             CALL    SpectrumShowInitialMode
  50  802B
  51  802B                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  52  802B 01 DE 03             LD      BC,$03DE
  53  802E 3E 03                LD      A,$03
  54  8030 ED 79                OUT     (C),A
  55  8032
  56  8032                      ; Configure packed-pixel 640x480 RGB565:
  57  8032                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  58  8032 3E 00                LD      A,0
  59  8034 1E 80                LD      E,$80
  60  8036 CD A0 80             CALL    WriteVgaRegister
  61  8039 3E 01                LD      A,1
  62  803B 1E 02                LD      E,$02
  63  803D CD A0 80             CALL    WriteVgaRegister
  64  8040 3E 02                LD      A,2
  65  8042 1E E0                LD      E,$E0
  66  8044 CD A0 80             CALL    WriteVgaRegister
  67  8047 3E 03                LD      A,3
  68  8049 1E 01                LD      E,$01
  69  804B CD A0 80             CALL    WriteVgaRegister
  70  804E 3E 04                LD      A,4
  71  8050 1E 10                LD      E,16
  72  8052 CD A0 80             CALL    WriteVgaRegister
  73  8055 3E 05                LD      A,5
  74  8057 1E 01                LD      E,1
  75  8059 CD A0 80             CALL    WriteVgaRegister
  76  805C
  77  805C 21 87 8A             LD      HL,MsgModeSet
  78  805F CD FC 84             CALL    DebugPrint
  79  8062
  80  8062 CD AA 80             CALL    Fill640x480x16
  81  8065
  82  8065 21 A1 8A             LD      HL,MsgFrameWritten
  83  8068 CD FC 84             CALL    DebugPrint
  84  806B CD 74 84             CALL    SpectrumShowInitialWriteComplete
  85  806E
  86  806E CD EF 80             CALL    VerifyFramebuffer
  87  8071 B7                   OR      A
  88  8072 20 12                JR      NZ,VgaTestFailed
  89  8074
  90  8074 21 BD 8A             LD      HL,MsgReadbackPass
  91  8077 CD FC 84             CALL    DebugPrint
  92  807A
  93  807A CD 22 81             CALL    RunPackedModeSweep
  94  807D
  95  807D 21 E7 8A             LD      HL,MsgReady
  96  8080 CD FC 84             CALL    DebugPrint
  97  8083
  98  8083              VgaTestIdle:
  99  8083 76                   HALT
 100  8084 18 FD                JR      VgaTestIdle
 101  8086
 102  8086              VgaTestFailed:
 103  8086 21 D2 8A             LD      HL,MsgReadbackFail
 104  8089 CD FC 84             CALL    DebugPrint
 105  808C              VgaTestFailedIdle:
 106  808C 76                   HALT
 107  808D 18 FD                JR      VgaTestFailedIdle
 108  808F
 109  808F              ; -------------------------------------------------------------------------
 110  808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 111  808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 112  808F              ; -------------------------------------------------------------------------
 113  808F              OpenATMShadowPorts:
 114  808F 01 9F 80             LD      BC,ShadowPortsOpened
 115  8092 C5                   PUSH    BC
 116  8093 01 53 2A             LD      BC,$2A53
 117  8096 C5                   PUSH    BC
 118  8097 01 77 01             LD      BC,$0177
 119  809A 3E C3                LD      A,$C3
 120  809C C3 2F 3D             JP      $3D2F
 121  809F              ShadowPortsOpened:
 122  809F C9                   RET
 123  80A0
 124  80A0              ; A = indexed VGA register, E = value.
 125  80A0              WriteVgaRegister:
 126  80A0 01 E0 03             LD      BC,$03E0
 127  80A3 ED 79                OUT     (C),A
 128  80A5 7B                   LD      A,E
 129  80A6 0C                   INC     C
 130  80A7 ED 79                OUT     (C),A
 131  80A9 C9                   RET
 132  80AA
 133  80AA              ; -------------------------------------------------------------------------
 134  80AA              ; Fill the 640x480x16 framebuffer.
 135  80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 136  80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
 137  80AA              ; -------------------------------------------------------------------------
 138  80AA              Fill640x480x16:
 139  80AA AF                   XOR     A
 140  80AB 32 04 85             LD      (CurrentBank),A
 141  80AE
 142  80AE              FillBankLoop:
 143  80AE 3A 04 85             LD      A,(CurrentBank)
 144  80B1 01 DF 03             LD      BC,$03DF
 145  80B4 ED 79                OUT     (C),A
 146  80B6
 147  80B6 21 00 C0             LD      HL,$C000
 148  80B9 11 BC 89             LD      DE,ColorPattern
 149  80BC 3A 04 85             LD      A,(CurrentBank)
 150  80BF FE 25                CP      37
 151  80C1 28 05                JR      Z,FillLastHalfBank
 152  80C3 01 00 40             LD      BC,$4000
 153  80C6 18 03                JR      FillBankBytes
 154  80C8
 155  80C8              FillLastHalfBank:
 156  80C8 01 00 20             LD      BC,$2000
 157  80CB
 158  80CB              FillBankBytes:
 159  80CB 1A                   LD      A,(DE)
 160  80CC 13                   INC     DE
 161  80CD 77                   LD      (HL),A
 162  80CE 23                   INC     HL
 163  80CF
 164  80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 165  80CF F5                   PUSH    AF
 166  80D0 7A                   LD      A,D
 167  80D1 FE 8A                CP      HIGH ColorPatternEnd
 168  80D3 20 08                JR      NZ,PatternPointerReady
 169  80D5 7B                   LD      A,E
 170  80D6 FE 3C                CP      LOW ColorPatternEnd
 171  80D8 20 03                JR      NZ,PatternPointerReady
 172  80DA 11 BC 89             LD      DE,ColorPattern
 173  80DD              PatternPointerReady:
 174  80DD F1                   POP     AF
 175  80DE
 176  80DE 0B                   DEC     BC
 177  80DF 78                   LD      A,B
 178  80E0 B1                   OR      C
 179  80E1 20 E8                JR      NZ,FillBankBytes
 180  80E3
 181  80E3 3A 04 85             LD      A,(CurrentBank)
 182  80E6 3C                   INC     A
 183  80E7 32 04 85             LD      (CurrentBank),A
 184  80EA FE 26                CP      38
 185  80EC 20 C0                JR      NZ,FillBankLoop
 186  80EE C9                   RET
 187  80EF
 188  80EF              ; -------------------------------------------------------------------------
 189  80EF              ; Readback checks:
 190  80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 191  80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 192  80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 193  80EF              ; Return A=0 on success, A=1 on mismatch.
 194  80EF              ; -------------------------------------------------------------------------
 195  80EF              VerifyFramebuffer:
 196  80EF AF                   XOR     A
 197  80F0 01 DF 03             LD      BC,$03DF
 198  80F3 ED 79                OUT     (C),A
 199  80F5
 200  80F5 21 00 C0             LD      HL,$C000
 201  80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
 202  80F8 7E                   LD      A,(HL)
 203  80F9 B7                   OR      A
 204  80FA 20 23                JR      NZ,VerifyFailed
 205  80FC 23                   INC     HL
 206  80FD 7E                   LD      A,(HL)
 207  80FE B7                   OR      A
 208  80FF 20 1E                JR      NZ,VerifyFailed
 209  8101
 210  8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 211  8101 21 10 C0             LD      HL,$C010
 212  8104 7E                   LD      A,(HL)
 213  8105 FE 1F                CP      $1F
 214  8107 20 16                JR      NZ,VerifyFailed
 215  8109 23                   INC     HL
 216  810A 7E                   LD      A,(HL)
 217  810B B7                   OR      A
 218  810C 20 11                JR      NZ,VerifyFailed
 219  810E
 220  810E 3E 25                LD      A,37
 221  8110 01 DF 03             LD      BC,$03DF
 222  8113 ED 79                OUT     (C),A
 223  8115 21 FF DF             LD      HL,$DFFF
 224  8118 7E                   LD      A,(HL)
 225  8119 FE FF                CP      $FF
 226  811B 20 02                JR      NZ,VerifyFailed
 227  811D
 228  811D AF                   XOR     A
 229  811E C9                   RET
 230  811F
 231  811F              VerifyFailed:
 232  811F 3E 01                LD      A,1
 233  8121 C9                   RET
 234  8122
 235  8122
 236  8122              ; -------------------------------------------------------------------------
 237  8122              ; Sweep every packed-pixel mode accepted by the Project131 1 MiB adapter.
 238  8122              ; Supported combinations are taken from docs/ISA_VGA_Adapter.md.
 239  8122              ; Each mode writes only its active framebuffer size. The final bank may
 240  8122              ; be partially used; bytes outside the framebuffer are left untouched.
 241  8122              ; -------------------------------------------------------------------------
 242  8122              RunPackedModeSweep:
 243  8122 21 0E 8B             LD      HL,MsgSweepStart
 244  8125 CD FC 84             CALL    DebugPrint
 245  8128 21 36 85             LD      HL,PackedModeTable
 246  812B 22 05 85             LD      (ModeTablePtr),HL
 247  812E 21 9E 85             LD      HL,ModeLabelTable
 248  8131 22 07 85             LD      (ModeLabelPtr),HL
 249  8134 3E 0D                LD      A,13
 250  8136 32 0A 85             LD      (ModeCount),A
 251  8139 3E 01                LD      A,1
 252  813B 32 09 85             LD      (ModeIndex),A
 253  813E
 254  813E              PackedModeNext:
 255  813E 2A 05 85             LD      HL,(ModeTablePtr)
 256  8141 7E                   LD      A,(HL)
 257  8142 23                   INC     HL
 258  8143 32 0B 85             LD      (ModeXLo),A
 259  8146 7E                   LD      A,(HL)
 260  8147 23                   INC     HL
 261  8148 32 0C 85             LD      (ModeXHi),A
 262  814B 7E                   LD      A,(HL)
 263  814C 23                   INC     HL
 264  814D 32 0D 85             LD      (ModeYLo),A
 265  8150 7E                   LD      A,(HL)
 266  8151 23                   INC     HL
 267  8152 32 0E 85             LD      (ModeYHi),A
 268  8155 7E                   LD      A,(HL)
 269  8156 23                   INC     HL
 270  8157 32 0F 85             LD      (ModeBpp),A
 271  815A 7E                   LD      A,(HL)
 272  815B 23                   INC     HL
 273  815C 32 10 85             LD      (ModeBankCount),A
 274  815F 7E                   LD      A,(HL)
 275  8160 23                   INC     HL
 276  8161 32 11 85             LD      (ModeLastBankBytes),A
 277  8164 7E                   LD      A,(HL)
 278  8165 23                   INC     HL
 279  8166 32 12 85             LD      (ModeLastBankBytes+1),A
 280  8169 22 05 85             LD      (ModeTablePtr),HL
 281  816C
 282  816C 3A 0B 85             LD      A,(ModeXLo)
 283  816F 5F                   LD      E,A
 284  8170 3E 00                LD      A,0
 285  8172 CD A0 80             CALL    WriteVgaRegister
 286  8175 3A 0C 85             LD      A,(ModeXHi)
 287  8178 5F                   LD      E,A
 288  8179 3E 01                LD      A,1
 289  817B CD A0 80             CALL    WriteVgaRegister
 290  817E 3A 0D 85             LD      A,(ModeYLo)
 291  8181 5F                   LD      E,A
 292  8182 3E 02                LD      A,2
 293  8184 CD A0 80             CALL    WriteVgaRegister
 294  8187 3A 0E 85             LD      A,(ModeYHi)
 295  818A 5F                   LD      E,A
 296  818B 3E 03                LD      A,3
 297  818D CD A0 80             CALL    WriteVgaRegister
 298  8190 3A 0F 85             LD      A,(ModeBpp)
 299  8193 5F                   LD      E,A
 300  8194 3E 04                LD      A,4
 301  8196 CD A0 80             CALL    WriteVgaRegister
 302  8199 3E 05                LD      A,5
 303  819B 1E 01                LD      E,1
 304  819D CD A0 80             CALL    WriteVgaRegister
 305  81A0
 306  81A0 21 2D 8B             LD      HL,MsgModePrefix
 307  81A3 CD FC 84             CALL    DebugPrint
 308  81A6 3A 0C 85             LD      A,(ModeXHi)
 309  81A9 CD 49 83             CALL    DebugHexByte
 310  81AC 3A 0B 85             LD      A,(ModeXLo)
 311  81AF CD 49 83             CALL    DebugHexByte
 312  81B2 3E 78                LD      A,'x'
 313  81B4 D3 EF                OUT     ($EF),A
 314  81B6 3A 0E 85             LD      A,(ModeYHi)
 315  81B9 CD 49 83             CALL    DebugHexByte
 316  81BC 3A 0D 85             LD      A,(ModeYLo)
 317  81BF CD 49 83             CALL    DebugHexByte
 318  81C2 3E 20                LD      A,' '
 319  81C4 D3 EF                OUT     ($EF),A
 320  81C6 3A 0F 85             LD      A,(ModeBpp)
 321  81C9 CD 49 83             CALL    DebugHexByte
 322  81CC 21 33 8B             LD      HL,MsgBppSuffix
 323  81CF CD FC 84             CALL    DebugPrint
 324  81D2
 325  81D2                      ; Show the selected mode before writing only its framebuffer.
 326  81D2 CD 90 84             CALL    SpectrumShowMode
 327  81D5 CD 05 82             CALL    FillModeVRAM
 328  81D8 CD BC 84             CALL    SpectrumShowWriteComplete
 329  81DB                      ; Do not change mode until the user presses and releases SPACE.
 330  81DB CD EC 84             CALL    WaitSpace
 331  81DE
 332  81DE 3A 09 85             LD      A,(ModeIndex)
 333  81E1 3C                   INC     A
 334  81E2 32 09 85             LD      (ModeIndex),A
 335  81E5
 336  81E5 3A 0A 85             LD      A,(ModeCount)
 337  81E8 3D                   DEC     A
 338  81E9 32 0A 85             LD      (ModeCount),A
 339  81EC C2 3E 81             JP      NZ,PackedModeNext
 340  81EF 21 46 8B             LD      HL,MsgSweepDone
 341  81F2 CD FC 84             CALL    DebugPrint
 342  81F5 CD 17 84             CALL    SpectrumClear
 343  81F8 21 64 8B             LD      HL,ScreenTitle
 344  81FB CD 63 83             CALL    SpectrumPrint
 345  81FE 21 AA 8C             LD      HL,ScreenAllDone
 346  8201 CD 63 83             CALL    SpectrumPrint
 347  8204 C9                   RET
 348  8205
 349  8205              ; Fill exactly the active framebuffer size, not the full 1 MiB VRAM.
 350  8205              ; ModeBankCount is the number of aperture banks touched. The last bank
 351  8205              ; uses ModeLastBankBytes; all earlier banks use the full 16 KiB aperture.
 352  8205              FillModeVRAM:
 353  8205 AF                   XOR     A
 354  8206 32 04 85             LD      (CurrentBank),A
 355  8209              ModeFillBank:
 356  8209 3A 04 85             LD      A,(CurrentBank)
 357  820C 01 DF 03             LD      BC,$03DF
 358  820F ED 79                OUT     (C),A
 359  8211 21 00 C0             LD      HL,$C000
 360  8214 11 26 85             LD      DE,ModePattern
 361  8217 3A 04 85             LD      A,(CurrentBank)
 362  821A 47                   LD      B,A
 363  821B 3A 10 85             LD      A,(ModeBankCount)
 364  821E 3D                   DEC     A
 365  821F B8                   CP      B
 366  8220 20 0D                JR      NZ,ModeFillFullBank
 367  8222 ED 4B 11 85          LD      BC,(ModeLastBankBytes)
 368  8226 78                   LD      A,B
 369  8227 B1                   OR      C
 370  8228 20 08                JR      NZ,ModeFillCountReady
 371  822A 01 00 40             LD      BC,$4000
 372  822D 18 03                JR      ModeFillCountReady
 373  822F              ModeFillFullBank:
 374  822F 01 00 40             LD      BC,$4000
 375  8232              ModeFillCountReady:
 376  8232              ModeFillByte:
 377  8232 1A                   LD      A,(DE)
 378  8233 13                   INC     DE
 379  8234 77                   LD      (HL),A
 380  8235 23                   INC     HL
 381  8236 7A                   LD      A,D
 382  8237 FE 85                CP      HIGH ModePatternEnd
 383  8239 20 08                JR      NZ,ModePatternReady
 384  823B 7B                   LD      A,E
 385  823C FE 36                CP      LOW ModePatternEnd
 386  823E 20 03                JR      NZ,ModePatternReady
 387  8240 11 26 85             LD      DE,ModePattern
 388  8243              ModePatternReady:
 389  8243 0B                   DEC     BC
 390  8244 78                   LD      A,B
 391  8245 B1                   OR      C
 392  8246 20 EA                JR      NZ,ModeFillByte
 393  8248 3A 04 85             LD      A,(CurrentBank)
 394  824B 3C                   INC     A
 395  824C 32 04 85             LD      (CurrentBank),A
 396  824F 47                   LD      B,A
 397  8250 3A 10 85             LD      A,(ModeBankCount)
 398  8253 B8                   CP      B
 399  8254 20 B3                JR      NZ,ModeFillBank
 400  8256 C9                   RET
 401  8257
 402  8257              ModeHoldDelay:
 403  8257 11 FF FF             LD      DE,$FFFF
 404  825A              ModeHoldLoop:
 405  825A 1B                   DEC     DE
 406  825B 7A                   LD      A,D
 407  825C B3                   OR      E
 408  825D 20 FB                JR      NZ,ModeHoldLoop
 409  825F C9                   RET
 410  8260
 411  8260              ; -------------------------------------------------------------------------
 412  8260              ; Draw "P132 VGA TEST" with the Spectrum ROM character set.
 413  8260              ; The standard 8x8 ROM font starts at 3D00h (character 32).
 414  8260              ; Draws one 104-pixel line at the top of bank 0. The chosen modes keep
 415  8260              ; the complete 8 scanlines inside the first 16 KiB aperture bank.
 416  8260              ; -------------------------------------------------------------------------
 417  8260              DrawSpectrumBanner:
 418  8260                      ; Select framebuffer bank zero.
 419  8260 AF                   XOR     A
 420  8261 01 DF 03             LD      BC,$03DF
 421  8264 ED 79                OUT     (C),A
 422  8266
 423  8266                      ; Bytes per pixel: ceil(BPP/8).
 424  8266 3A 0F 85             LD      A,(ModeBpp)
 425  8269 FE 08                CP      8
 426  826B 3E 01                LD      A,1
 427  826D 28 18                JR      Z,DrawBytesReady
 428  826F 3A 0F 85             LD      A,(ModeBpp)
 429  8272 FE 10                CP      16
 430  8274 3E 02                LD      A,2
 431  8276 38 0F                JR      C,DrawBytesReady
 432  8278 28 0D                JR      Z,DrawBytesReady
 433  827A 3A 0F 85             LD      A,(ModeBpp)
 434  827D FE 18                CP      24
 435  827F 3E 03                LD      A,3
 436  8281 38 04                JR      C,DrawBytesReady
 437  8283 28 02                JR      Z,DrawBytesReady
 438  8285 3E 04                LD      A,4
 439  8287              DrawBytesReady:
 440  8287 32 13 85             LD      (DrawBytes),A
 441  828A
 442  828A                      ; Calculate pitch = X resolution * bytes per pixel.
 443  828A 3A 0B 85             LD      A,(ModeXLo)
 444  828D 6F                   LD      L,A
 445  828E 3A 0C 85             LD      A,(ModeXHi)
 446  8291 67                   LD      H,A
 447  8292 EB                   EX      DE,HL
 448  8293 21 00 00             LD      HL,0
 449  8296 3A 13 85             LD      A,(DrawBytes)
 450  8299              DrawPitchLoop:
 451  8299 19                   ADD     HL,DE
 452  829A 3D                   DEC     A
 453  829B 20 FC                JR      NZ,DrawPitchLoop
 454  829D 22 18 85             LD      (DrawPitch),HL
 455  82A0
 456  82A0 AF                   XOR     A
 457  82A1 32 14 85             LD      (DrawRow),A
 458  82A4 32 1A 85             LD      (DrawRowBase),A
 459  82A7 32 1B 85             LD      (DrawRowBase+1),A
 460  82AA
 461  82AA              DrawBannerRow:
 462  82AA                      ; Start this scanline at C000h + row * pitch.
 463  82AA 2A 1A 85             LD      HL,(DrawRowBase)
 464  82AD 11 00 C0             LD      DE,$C000
 465  82B0 19                   ADD     HL,DE
 466  82B1 22 1C 85             LD      (DrawPixelPtr),HL
 467  82B4 21 3B 83             LD      HL,DrawBannerText
 468  82B7 22 1E 85             LD      (DrawStringPtr),HL
 469  82BA
 470  82BA              DrawBannerChar:
 471  82BA 2A 1E 85             LD      HL,(DrawStringPtr)
 472  82BD 7E                   LD      A,(HL)
 473  82BE B7                   OR      A
 474  82BF 28 3E                JR      Z,DrawBannerRowDone
 475  82C1 23                   INC     HL
 476  82C2 22 1E 85             LD      (DrawStringPtr),HL
 477  82C5
 478  82C5                      ; Font address = 3D00h + (ASCII - 20h) * 8 + scanline.
 479  82C5 D6 20                SUB     32
 480  82C7 6F                   LD      L,A
 481  82C8 26 00                LD      H,0
 482  82CA 29                   ADD     HL,HL
 483  82CB 29                   ADD     HL,HL
 484  82CC 29                   ADD     HL,HL
 485  82CD 11 00 3D             LD      DE,$3D00
 486  82D0 19                   ADD     HL,DE
 487  82D1 3A 14 85             LD      A,(DrawRow)
 488  82D4 5F                   LD      E,A
 489  82D5 16 00                LD      D,0
 490  82D7 19                   ADD     HL,DE
 491  82D8 7E                   LD      A,(HL)
 492  82D9 32 16 85             LD      (DrawGlyphBits),A
 493  82DC 3E 08                LD      A,8
 494  82DE 32 15 85             LD      (DrawPixelCount),A
 495  82E1
 496  82E1              DrawBannerPixel:
 497  82E1 3A 16 85             LD      A,(DrawGlyphBits)
 498  82E4 07                   RLCA
 499  82E5 32 16 85             LD      (DrawGlyphBits),A
 500  82E8 3E 00                LD      A,0
 501  82EA 30 02                JR      NC,DrawBannerPixelInkReady
 502  82EC 3E 01                LD      A,1
 503  82EE              DrawBannerPixelInkReady:
 504  82EE 32 17 85             LD      (DrawInk),A
 505  82F1 CD 16 83             CALL    DrawBannerPutPixel
 506  82F4 3A 15 85             LD      A,(DrawPixelCount)
 507  82F7 3D                   DEC     A
 508  82F8 32 15 85             LD      (DrawPixelCount),A
 509  82FB 20 E4                JR      NZ,DrawBannerPixel
 510  82FD 18 BB                JR      DrawBannerChar
 511  82FF
 512  82FF              DrawBannerRowDone:
 513  82FF 2A 1A 85             LD      HL,(DrawRowBase)
 514  8302 ED 5B 18 85          LD      DE,(DrawPitch)
 515  8306 19                   ADD     HL,DE
 516  8307 22 1A 85             LD      (DrawRowBase),HL
 517  830A 3A 14 85             LD      A,(DrawRow)
 518  830D 3C                   INC     A
 519  830E 32 14 85             LD      (DrawRow),A
 520  8311 FE 08                CP      8
 521  8313 20 95                JR      NZ,DrawBannerRow
 522  8315 C9                   RET
 523  8316
 524  8316              ; Write one foreground/background pixel and advance the linear pointer.
 525  8316              DrawBannerPutPixel:
 526  8316 2A 1C 85             LD      HL,(DrawPixelPtr)
 527  8319 3A 17 85             LD      A,(DrawInk)
 528  831C B7                   OR      A
 529  831D 28 0D                JR      Z,DrawBannerBackground
 530  831F 3A 0F 85             LD      A,(ModeBpp)
 531  8322 FE 08                CP      8
 532  8324 3E FF                LD      A,$FF
 533  8326 20 05                JR      NZ,DrawBannerPixelValueReady
