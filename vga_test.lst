235   811E 2A 1D 82             LD      HL,(ModeTablePtr)
236   8121 7E                   LD      A,(HL)
237   8122 23                   INC     HL
238   8123 32 20 82             LD      (ModeXLo),A
239   8126 7E                   LD      A,(HL)
240   8127 23                   INC     HL
241   8128 32 21 82             LD      (ModeXHi),A
242   812B 7E                   LD      A,(HL)
243   812C 23                   INC     HL
244   812D 32 22 82             LD      (ModeYLo),A
245   8130 7E                   LD      A,(HL)
246   8131 23                   INC     HL
247   8132 32 23 82             LD      (ModeYHi),A
248   8135 7E                   LD      A,(HL)
249   8136 23                   INC     HL
250   8137 32 24 82             LD      (ModeBpp),A
251   813A 22 1D 82             LD      (ModeTablePtr),HL
252   813D
253   813D 3E 00                LD      A,0
254   813F 3A 20 82             LD      A,(ModeXLo)
255   8142 5F                   LD      E,A
256   8143 CD 8B 80             CALL    WriteVgaRegister
257   8146 3E 01                LD      A,1
258   8148 3A 21 82             LD      A,(ModeXHi)
259   814B 5F                   LD      E,A
260   814C CD 8B 80             CALL    WriteVgaRegister
261   814F 3E 02                LD      A,2
262   8151 3A 22 82             LD      A,(ModeYLo)
263   8154 5F                   LD      E,A
264   8155 CD 8B 80             CALL    WriteVgaRegister
265   8158 3E 03                LD      A,3
266   815A 3A 23 82             LD      A,(ModeYHi)
267   815D 5F                   LD      E,A
268   815E CD 8B 80             CALL    WriteVgaRegister
269   8161 3E 04                LD      A,4
270   8163 3A 24 82             LD      A,(ModeBpp)
271   8166 5F                   LD      E,A
272   8167 CD 8B 80             CALL    WriteVgaRegister
273   816A 3E 05                LD      A,5
274   816C 1E 01                LD      E,1
275   816E CD 8B 80             CALL    WriteVgaRegister
276   8171
277   8171 21 E7 83             LD      HL,MsgModePrefix
278   8174 CD 14 82             CALL    DebugPrint
279   8177 3A 21 82             LD      A,(ModeXHi)
280   817A CD FA 81             CALL    DebugHexByte
281   817D 3A 20 82             LD      A,(ModeXLo)
282   8180 CD FA 81             CALL    DebugHexByte
283   8183 3E 78                LD      A,'x'
284   8185 D3 EF                OUT     ($EF),A
285   8187 3A 23 82             LD      A,(ModeYHi)
286   818A CD FA 81             CALL    DebugHexByte
287   818D 3A 22 82             LD      A,(ModeYLo)
288   8190 CD FA 81             CALL    DebugHexByte
289   8193 3E 20                LD      A,' '
290   8195 D3 EF                OUT     ($EF),A
291   8197 3A 24 82             LD      A,(ModeBpp)
292   819A CD FA 81             CALL    DebugHexByte
293   819D 21 ED 83             LD      HL,MsgBppSuffix
294   81A0 CD 14 82             CALL    DebugPrint
295   81A3
296   81A3 CD BA 81             CALL    FillModeVRAM
297   81A6 CD F1 81             CALL    ModeHoldDelay
298   81A9
299   81A9 3A 1F 82             LD      A,(ModeCount)
