323   81DE              ; Fill 1 MiB with a repeating RGB/index-friendly byte pattern.
324   81DE              ; All 64 banks are written so the test covers the full VRAM aperture.
325   81DE              FillModeVRAM:
326   81DE AF                   XOR     A
327   81DF 32 76 83             LD      (CurrentBank),A
328   81E2              ModeFillBank:
329   81E2 3A 76 83             LD      A,(CurrentBank)
330   81E5 01 DF 03             LD      BC,$03DF
331   81E8 ED 79                OUT     (C),A
332   81EA 21 00 C0             LD      HL,$C000
333   81ED 11 8F 83             LD      DE,ModePattern
334   81F0 01 00 40             LD      BC,$4000
335   81F3              ModeFillByte:
336   81F3 1A                   LD      A,(DE)
337   81F4 13                   INC     DE
338   81F5 77                   LD      (HL),A
339   81F6 23                   INC     HL
340   81F7 7A                   LD      A,D
341   81F8 FE 83                CP      HIGH ModePatternEnd
342   81FA 20 08                JR      NZ,ModePatternReady
343   81FC 7B                   LD      A,E
344   81FD FE 9F                CP      LOW ModePatternEnd
345   81FF 20 03                JR      NZ,ModePatternReady
346   8201 11 8F 83             LD      DE,ModePattern
347   8204              ModePatternReady:
