 341  825B              OpenATMShadowPorts:
 342  825B 01 6B 82             LD      BC,ShadowPortsOpened
 343  825E C5                   PUSH    BC
 344  825F 01 53 2A             LD      BC,$2A53
 345  8262 C5                   PUSH    BC
 346  8263 01 77 01             LD      BC,$0177
 347  8266 3E C3                LD      A,$C3
 348  8268 C3 2F 3D             JP      $3D2F
 349  826B              ShadowPortsOpened:
