  68  8049 1E 01                LD      E,$01
  69  804B CD 6C 82             CALL    WriteVgaRegister
  70  804E 3E 04                LD      A,4
  71  8050 1E 10                LD      E,16
  72  8052 CD 6C 82             CALL    WriteVgaRegister
  73  8055 3E 05                LD      A,5
  74  8057 1E 01                LD      E,1
  75  8059 CD 6C 82             CALL    WriteVgaRegister
  76  805C
  77  805C 21 83 8C             LD      HL,MsgModeSet
  78  805F CD E8 86             CALL    DebugPrint
  79  8062
  80  8062 CD 76 82             CALL    Fill640x480x16
  81  8065
  82  8065 21 9D 8C             LD      HL,MsgFrameWritten
  83  8068 CD E8 86             CALL    DebugPrint
  84  806B CD 60 86             CALL    SpectrumShowInitialWriteComplete
  85  806E
  86  806E CD BB 82             CALL    VerifyFramebuffer
  87  8071 B7                   OR      A
  88  8072 20 15                JR      NZ,VgaTestFailed
  89  8074
  90  8074 21 B9 8C             LD      HL,MsgReadbackPass
  91  8077 CD E8 86             CALL    DebugPrint
  92  807A
