 352  826C              ; A = indexed VGA register, E = value.
 353  826C              WriteVgaRegister:
 354  826C 01 E0 03             LD      BC,$03E0
 355  826F ED 79                OUT     (C),A
 356  8271 7B                   LD      A,E
 357  8272 0C                   INC     C
 358  8273 ED 79                OUT     (C),A
