# file opened: vga_test.asm
  1   0000              ; =========================================================================
  2   0000              ; PROJECT132 — ATM TURBO 2+ VGA ADAPTER TEST
  3   0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
  4   0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
  5   0000              ;
  6   0000              ; Test:
  7   0000              ;   - unlock ATM shadow ports through TR-DOS ROM
  8   0000              ;   - enable VGA software mode + 16 KiB aperture
  9   0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
 10   0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
 11   0000              ;   - read back bytes from bank 0 and the last framebuffer bank
 12   0000              ;   - report results on port EF (spectrum_out.txt)
 13   0000              ;
 14   0000              ; Expected image: eight-colour RGB565 vertical bars.
 15   0000              ; =========================================================================
 16   0000
 17   0000                      DEVICE ZXSPECTRUM128
 18   0000                      EMPTYTRD "vga_test.TRD"
 19   0000
 20   0000                      ORG     $8000
 21   8000
 22   8000              VgaTestEntry:
 23   8000 F3                   DI
 24   8001 31 FF BF             LD      SP,$BFFF
 25   8004
 26   8004                      ; Keep the same interrupt state as the proven Project112 startup.
 27   8004 CD 44 83             CALL    SpectrumShowStartup
 28   8007
 29   8007 21 21 88             LD      HL,MsgBuild
 30   800A CD 07 84             CALL    DebugPrint
 31   800D 21 38 88             LD      HL,MsgStart
 32   8010 CD 07 84             CALL    DebugPrint
 33   8013
 34   8013 21 80 89             LD      HL,ScreenOpeningPorts
 35   8016 CD 54 83             CALL    SpectrumShowStatus
 36   8019 CD 8F 80             CALL    OpenATMShadowPorts
 37   801C
 38   801C                      ; Match the proven Project112 page selection after shadow-port unlock.
 39   801C AF                   XOR     A
 40   801D 01 FD 7F             LD      BC,$7FFD
 41   8020 ED 79                OUT     (C),A
 42   8022
 43   8022 21 55 88             LD      HL,MsgAdapterInit
 44   8025 CD 07 84             CALL    DebugPrint
 45   8028
 46   8028                      ; The initial framebuffer test is also identified on the Spectrum screen.
 47   8028 CD 63 83             CALL    SpectrumShowInitialMode
 48   802B
 49   802B                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
 50   802B 01 DE 03             LD      BC,$03DE
 51   802E 3E 03                LD      A,$03
 52   8030 ED 79                OUT     (C),A
 53   8032
 54   8032                      ; Configure packed-pixel 640x480 RGB565:
 55   8032                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
 56   8032 3E 00                LD      A,0
 57   8034 1E 80                LD      E,$80
 58   8036 CD A0 80             CALL    WriteVgaRegister
 59   8039 3E 01                LD      A,1
 60   803B 1E 02                LD      E,$02
 61   803D CD A0 80             CALL    WriteVgaRegister
 62   8040 3E 02                LD      A,2
 63   8042 1E E0                LD      E,$E0
 64   8044 CD A0 80             CALL    WriteVgaRegister
 65   8047 3E 03                LD      A,3
 66   8049 1E 01                LD      E,$01
 67   804B CD A0 80             CALL    WriteVgaRegister
 68   804E 3E 04                LD      A,4
 69   8050 1E 10                LD      E,16
 70   8052 CD A0 80             CALL    WriteVgaRegister
 71   8055 3E 05                LD      A,5
 72   8057 1E 01                LD      E,1
 73   8059 CD A0 80             CALL    WriteVgaRegister
 74   805C
 75   805C 21 6C 88             LD      HL,MsgModeSet
 76   805F CD 07 84             CALL    DebugPrint
 77   8062
 78   8062 CD AA 80             CALL    Fill640x480x16
 79   8065
 80   8065 21 86 88             LD      HL,MsgFrameWritten
 81   8068 CD 07 84             CALL    DebugPrint
 82   806B CD 7F 83             CALL    SpectrumShowInitialWriteComplete
 83   806E
 84   806E CD EF 80             CALL    VerifyFramebuffer
 85   8071 B7                   OR      A
 86   8072 20 12                JR      NZ,VgaTestFailed
 87   8074
 88   8074 21 A2 88             LD      HL,MsgReadbackPass
 89   8077 CD 07 84             CALL    DebugPrint
 90   807A
 91   807A CD 22 81             CALL    RunPackedModeSweep
 92   807D
 93   807D 21 CC 88             LD      HL,MsgReady
 94   8080 CD 07 84             CALL    DebugPrint
 95   8083
 96   8083              VgaTestIdle:
 97   8083 76                   HALT
 98   8084 18 FD                JR      VgaTestIdle
 99   8086
100   8086              VgaTestFailed:
101   8086 21 B7 88             LD      HL,MsgReadbackFail
102   8089 CD 07 84             CALL    DebugPrint
103   808C              VgaTestFailedIdle:
104   808C 76                   HALT
105   808D 18 FD                JR      VgaTestFailedIdle
