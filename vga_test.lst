101   8084              ; -------------------------------------------------------------------------
102   8084              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
103   8084              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
104   8084              ; -------------------------------------------------------------------------
105   8084              OpenATMShadowPorts:
106   8084 01 94 80             LD      BC,ShadowPortsOpened
107   8087 C5                   PUSH    BC
108   8088 01 53 2A             LD      BC,$2A53
109   808B C5                   PUSH    BC
110   808C 01 77 01             LD      BC,$0177
111   808F 3E C3                LD      A,$C3
112   8091 C3 2F 3D             JP      $3D2F
113   8094              ShadowPortsOpened:
114   8094 C9                   RET
115   8095
116   8095              ; A = indexed VGA register, E = value.
117   8095              WriteVgaRegister:
118   8095 01 E0 03             LD      BC,$03E0
119   8098 ED 79                OUT     (C),A
120   809A 7B                   LD      A,E
121   809B 0C                   INC     C
122   809C ED 79                OUT     (C),A
123   809E C9                   RET
124   809F
125   809F              ; -------------------------------------------------------------------------
126   809F              ; Fill the 640x480x16 framebuffer.
127   809F              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
128   809F              ; The aperture C000h-FFFFh is switched with port 3DFh.
129   809F              ; -------------------------------------------------------------------------
130   809F              Fill640x480x16:
131   809F AF                   XOR     A
132   80A0 32 F5 83             LD      (CurrentBank),A
133   80A3
134   80A3              FillBankLoop:
135   80A3 3A F5 83             LD      A,(CurrentBank)
136   80A6 01 DF 03             LD      BC,$03DF
137   80A9 ED 79                OUT     (C),A
138   80AB
139   80AB 21 00 C0             LD      HL,$C000
140   80AE 11 87 87             LD      DE,ColorPattern
141   80B1 3A F5 83             LD      A,(CurrentBank)
142   80B4 FE 25                CP      37
143   80B6 28 05                JR      Z,FillLastHalfBank
144   80B8 01 00 40             LD      BC,$4000
145   80BB 18 03                JR      FillBankBytes
146   80BD
147   80BD              FillLastHalfBank:
148   80BD 01 00 20             LD      BC,$2000
149   80C0
150   80C0              FillBankBytes:
151   80C0 1A                   LD      A,(DE)
152   80C1 13                   INC     DE
153   80C2 77                   LD      (HL),A
154   80C3 23                   INC     HL
155   80C4
156   80C4                      ; Repeat the 128-byte RGB565 colour-bar sequence.
157   80C4 F5                   PUSH    AF
158   80C5 7A                   LD      A,D
159   80C6 FE 88                CP      HIGH ColorPatternEnd
160   80C8 20 08                JR      NZ,PatternPointerReady
161   80CA 7B                   LD      A,E
162   80CB FE 07                CP      LOW ColorPatternEnd
163   80CD 20 03                JR      NZ,PatternPointerReady
164   80CF 11 87 87             LD      DE,ColorPattern
165   80D2              PatternPointerReady:
166   80D2 F1                   POP     AF
167   80D3
168   80D3 0B                   DEC     BC
169   80D4 78                   LD      A,B
170   80D5 B1                   OR      C
171   80D6 20 E8                JR      NZ,FillBankBytes
172   80D8
173   80D8 3A F5 83             LD      A,(CurrentBank)
174   80DB 3C                   INC     A
175   80DC 32 F5 83             LD      (CurrentBank),A
176   80DF FE 26                CP      38
177   80E1 20 C0                JR      NZ,FillBankLoop
178   80E3 C9                   RET
179   80E4
180   80E4              ; -------------------------------------------------------------------------
181   80E4              ; Readback checks:
182   80E4              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
183   80E4              ; bank 37 starts at linear offset 37*4000h = 5E000h.
184   80E4              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
185   80E4              ; Return A=0 on success, A=1 on mismatch.
186   80E4              ; -------------------------------------------------------------------------
187   80E4              VerifyFramebuffer:
188   80E4 AF                   XOR     A
189   80E5 01 DF 03             LD      BC,$03DF
190   80E8 ED 79                OUT     (C),A
191   80EA
192   80EA 21 00 C0             LD      HL,$C000
193   80ED                      ; First eight pixels are black: bytes 0..15 must be zero.
194   80ED 7E                   LD      A,(HL)
195   80EE B7                   OR      A
196   80EF 20 23                JR      NZ,VerifyFailed
197   80F1 23                   INC     HL
198   80F2 7E                   LD      A,(HL)
199   80F3 B7                   OR      A
200   80F4 20 1E                JR      NZ,VerifyFailed
201   80F6
202   80F6                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
203   80F6 21 10 C0             LD      HL,$C010
204   80F9 7E                   LD      A,(HL)
205   80FA FE 1F                CP      $1F
206   80FC 20 16                JR      NZ,VerifyFailed
207   80FE 23                   INC     HL
208   80FF 7E                   LD      A,(HL)
209   8100 B7                   OR      A
210   8101 20 11                JR      NZ,VerifyFailed
211   8103
212   8103 3E 25                LD      A,37
213   8105 01 DF 03             LD      BC,$03DF
214   8108 ED 79                OUT     (C),A
215   810A 21 FF DF             LD      HL,$DFFF
216   810D 7E                   LD      A,(HL)
217   810E FE FF                CP      $FF
218   8110 20 02                JR      NZ,VerifyFailed
219   8112
220   8112 AF                   XOR     A
221   8113 C9                   RET
222   8114
223   8114              VerifyFailed:
224   8114 3E 01                LD      A,1
225   8116 C9                   RET
226   8117
227   8117
228   8117              ; -------------------------------------------------------------------------
229   8117              ; Sweep every packed-pixel mode accepted by the Project131 1 MiB adapter.
230   8117              ; Supported combinations are taken from docs/ISA_VGA_Adapter.md.
231   8117              ; Each mode is selected, the entire 1 MiB aperture is written, then held
232   8117              ; briefly so the VGA window can be inspected before advancing.
233   8117              ; -------------------------------------------------------------------------
234   8117              RunPackedModeSweep:
235   8117 21 D9 88             LD      HL,MsgSweepStart
236   811A CD ED 83             CALL    DebugPrint
237   811D 21 1E 84             LD      HL,PackedModeTable
238   8120 22 F6 83             LD      (ModeTablePtr),HL
239   8123 21 5F 84             LD      HL,ModeLabelTable
240   8126 22 F8 83             LD      (ModeLabelPtr),HL
241   8129 3E 0D                LD      A,13
242   812B 32 FB 83             LD      (ModeCount),A
243   812E 3E 01                LD      A,1
244   8130 32 FA 83             LD      (ModeIndex),A
245   8133
246   8133              PackedModeNext:
247   8133 2A F6 83             LD      HL,(ModeTablePtr)
248   8136 7E                   LD      A,(HL)
249   8137 23                   INC     HL
250   8138 32 FC 83             LD      (ModeXLo),A
251   813B 7E                   LD      A,(HL)
252   813C 23                   INC     HL
253   813D 32 FD 83             LD      (ModeXHi),A
254   8140 7E                   LD      A,(HL)
255   8141 23                   INC     HL
256   8142 32 FE 83             LD      (ModeYLo),A
257   8145 7E                   LD      A,(HL)
258   8146 23                   INC     HL
259   8147 32 FF 83             LD      (ModeYHi),A
260   814A 7E                   LD      A,(HL)
261   814B 23                   INC     HL
262   814C 32 00 84             LD      (ModeBpp),A
263   814F 22 F6 83             LD      (ModeTablePtr),HL
264   8152
265   8152 3A FC 83             LD      A,(ModeXLo)
266   8155 5F                   LD      E,A
267   8156 3E 00                LD      A,0
268   8158 CD 95 80             CALL    WriteVgaRegister
269   815B 3A FD 83             LD      A,(ModeXHi)
270   815E 5F                   LD      E,A
271   815F 3E 01                LD      A,1
272   8161 CD 95 80             CALL    WriteVgaRegister
273   8164 3A FE 83             LD      A,(ModeYLo)
274   8167 5F                   LD      E,A
275   8168 3E 02                LD      A,2
276   816A CD 95 80             CALL    WriteVgaRegister
277   816D 3A FF 83             LD      A,(ModeYHi)
278   8170 5F                   LD      E,A
279   8171 3E 03                LD      A,3
280   8173 CD 95 80             CALL    WriteVgaRegister
281   8176 3A 00 84             LD      A,(ModeBpp)
282   8179 5F                   LD      E,A
283   817A 3E 04                LD      A,4
284   817C CD 95 80             CALL    WriteVgaRegister
285   817F 3E 05                LD      A,5
286   8181 1E 01                LD      E,1
287   8183 CD 95 80             CALL    WriteVgaRegister
288   8186
289   8186 21 F8 88             LD      HL,MsgModePrefix
290   8189 CD ED 83             CALL    DebugPrint
291   818C 3A FD 83             LD      A,(ModeXHi)
292   818F CD 14 83             CALL    DebugHexByte
293   8192 3A FC 83             LD      A,(ModeXLo)
294   8195 CD 14 83             CALL    DebugHexByte
295   8198 3E 78                LD      A,'x'
296   819A D3 EF                OUT     ($EF),A
297   819C 3A FF 83             LD      A,(ModeYHi)
298   819F CD 14 83             CALL    DebugHexByte
299   81A2 3A FE 83             LD      A,(ModeYLo)
300   81A5 CD 14 83             CALL    DebugHexByte
301   81A8 3E 20                LD      A,' '
302   81AA D3 EF                OUT     ($EF),A
303   81AC 3A 00 84             LD      A,(ModeBpp)
304   81AF CD 14 83             CALL    DebugHexByte
305   81B2 21 FE 88             LD      HL,MsgBppSuffix
306   81B5 CD ED 83             CALL    DebugPrint
307   81B8
308   81B8                      ; Show the selected mode BEFORE the long 1 MiB VRAM fill.
309   81B8 CD 81 83             CALL    SpectrumShowMode
310   81BB CD EB 81             CALL    FillModeVRAM
311   81BE CD AD 83             CALL    SpectrumShowWriteComplete
312   81C1                      ; Do not change mode until the user presses and releases SPACE.
313   81C1 CD DD 83             CALL    WaitSpace
314   81C4
315   81C4 3A FA 83             LD      A,(ModeIndex)
316   81C7 3C                   INC     A
317   81C8 32 FA 83             LD      (ModeIndex),A
318   81CB
319   81CB 3A FB 83             LD      A,(ModeCount)
320   81CE 3D                   DEC     A
321   81CF 32 FB 83             LD      (ModeCount),A
322   81D2 C2 33 81             JP      NZ,PackedModeNext
323   81D5 21 11 89             LD      HL,MsgSweepDone
324   81D8 CD ED 83             CALL    DebugPrint
325   81DB CD 35 83             CALL    SpectrumClear
326   81DE 21 2F 89             LD      HL,ScreenTitle
327   81E1 CD 2E 83             CALL    SpectrumPrint
328   81E4 21 29 8A             LD      HL,ScreenAllDone
329   81E7 CD 2E 83             CALL    SpectrumPrint
330   81EA C9                   RET
331   81EB
332   81EB              ; Fill 1 MiB with a repeating RGB/index-friendly byte pattern.
333   81EB              ; All 64 banks are written so the test covers the full VRAM aperture.
334   81EB              FillModeVRAM:
335   81EB AF                   XOR     A
336   81EC 32 F5 83             LD      (CurrentBank),A
337   81EF              ModeFillBank:
338   81EF 3A F5 83             LD      A,(CurrentBank)
339   81F2 01 DF 03             LD      BC,$03DF
340   81F5 ED 79                OUT     (C),A
341   81F7 21 00 C0             LD      HL,$C000
342   81FA 11 0E 84             LD      DE,ModePattern
343   81FD 01 00 40             LD      BC,$4000
344   8200              ModeFillByte:
345   8200 1A                   LD      A,(DE)
346   8201 13                   INC     DE
347   8202 77                   LD      (HL),A
348   8203 23                   INC     HL
349   8204 7A                   LD      A,D
350   8205 FE 84                CP      HIGH ModePatternEnd
351   8207 20 08                JR      NZ,ModePatternReady
352   8209 7B                   LD      A,E
353   820A FE 1E                CP      LOW ModePatternEnd
354   820C 20 03                JR      NZ,ModePatternReady
355   820E 11 0E 84             LD      DE,ModePattern
356   8211              ModePatternReady:
357   8211 0B                   DEC     BC
358   8212 78                   LD      A,B
359   8213 B1                   OR      C
360   8214 20 EA                JR      NZ,ModeFillByte
361   8216 3A F5 83             LD      A,(CurrentBank)
362   8219 3C                   INC     A
363   821A 32 F5 83             LD      (CurrentBank),A
364   821D FE 40                CP      64
365   821F 20 CE                JR      NZ,ModeFillBank
366   8221 C9                   RET
367   8222
368   8222              ModeHoldDelay:
369   8222 11 FF FF             LD      DE,$FFFF
370   8225              ModeHoldLoop:
371   8225 1B                   DEC     DE
372   8226 7A                   LD      A,D
373   8227 B3                   OR      E
374   8228 20 FB                JR      NZ,ModeHoldLoop
375   822A C9                   RET
