# file opened: vga_test.asm
  1   0000              ; =========================================================================
  2   0000              ; PROJECT132 — ATM TURBO 2+ VGA ADAPTER TEST
  3   0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
  4   0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
  5   0000              ;
  6   0000              ; Test:
  7   0000              ;   - unlock ATM shadow ports through TR-DOS ROM
  8   0000              ;   - enable VGA software mode + 16 KiB aperture
  9   0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
 10   0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
 11   0000              ;   - read back bytes from bank 0 and the last framebuffer bank
 12   0000              ;   - report results on port EF (spectrum_out.txt)
 13   0000              ;
 14   0000              ; Expected image: eight-colour RGB565 vertical bars.
 15   0000              ; =========================================================================
 16   0000
 17   0000                      DEVICE ZXSPECTRUM128
 18   0000                      EMPTYTRD "vga_test.TRD"
 19   0000
 20   0000                      ORG     $8000
 21   8000
 22   8000              VgaTestEntry:
 23   8000 F3                   DI
 24   8001 31 FF BF             LD      SP,$BFFF
 25   8004
 26   8004 21 93 81             LD      HL,MsgBuild
 27   8007 CD 0A 81             CALL    DebugPrint
 28   800A 21 AA 81             LD      HL,MsgStart
 29   800D CD 0A 81             CALL    DebugPrint
 30   8010
 31   8010 CD 77 80             CALL    OpenATMShadowPorts
 32   8013
 33   8013 21 C7 81             LD      HL,MsgAdapterInit
 34   8016 CD 0A 81             CALL    DebugPrint
 35   8019
 36   8019                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
 37   8019 01 DE 03             LD      BC,$03DE
 38   801C 3E 03                LD      A,$03
 39   801E ED 79                OUT     (C),A
 40   8020
 41   8020                      ; Configure packed-pixel 640x480 RGB565:
 42   8020                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
 43   8020 3E 00                LD      A,0
 44   8022 1E 80                LD      E,$80
 45   8024 CD 88 80             CALL    WriteVgaRegister
 46   8027 3E 01                LD      A,1
 47   8029 1E 02                LD      E,$02
 48   802B CD 88 80             CALL    WriteVgaRegister
 49   802E 3E 02                LD      A,2
 50   8030 1E E0                LD      E,$E0
 51   8032 CD 88 80             CALL    WriteVgaRegister
 52   8035 3E 03                LD      A,3
 53   8037 1E 01                LD      E,$01
 54   8039 CD 88 80             CALL    WriteVgaRegister
 55   803C 3E 04                LD      A,4
 56   803E 1E 10                LD      E,16
 57   8040 CD 88 80             CALL    WriteVgaRegister
 58   8043 3E 05                LD      A,5
 59   8045 1E 01                LD      E,1
 60   8047 CD 88 80             CALL    WriteVgaRegister
 61   804A
 62   804A 21 DE 81             LD      HL,MsgModeSet
 63   804D CD 0A 81             CALL    DebugPrint
 64   8050
 65   8050 CD 92 80             CALL    Fill640x480x16
 66   8053
 67   8053 21 F8 81             LD      HL,MsgFrameWritten
 68   8056 CD 0A 81             CALL    DebugPrint
 69   8059
 70   8059 CD D7 80             CALL    VerifyFramebuffer
 71   805C B7                   OR      A
 72   805D 20 0F                JR      NZ,VgaTestFailed
 73   805F
 74   805F 21 14 82             LD      HL,MsgReadbackPass
 75   8062 CD 0A 81             CALL    DebugPrint
 76   8065 21 3E 82             LD      HL,MsgReady
 77   8068 CD 0A 81             CALL    DebugPrint
 78   806B
 79   806B              VgaTestIdle:
 80   806B 76                   HALT
 81   806C 18 FD                JR      VgaTestIdle
 82   806E
 83   806E              VgaTestFailed:
 84   806E 21 29 82             LD      HL,MsgReadbackFail
 85   8071 CD 0A 81             CALL    DebugPrint
 86   8074              VgaTestFailedIdle:
 87   8074 76                   HALT
 88   8075 18 FD                JR      VgaTestFailedIdle
 89   8077
 90   8077              ; -------------------------------------------------------------------------
 91   8077              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 92   8077              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 93   8077              ; -------------------------------------------------------------------------
 94   8077              OpenATMShadowPorts:
 95   8077 01 87 80             LD      BC,ShadowPortsOpened
 96   807A C5                   PUSH    BC
 97   807B 01 53 2A             LD      BC,$2A53
 98   807E C5                   PUSH    BC
 99   807F 01 77 01             LD      BC,$0177
100   8082 3E C3                LD      A,$C3
101   8084 C3 2F 3D             JP      $3D2F
102   8087              ShadowPortsOpened:
103   8087 C9                   RET
104   8088
105   8088              ; A = indexed VGA register, E = value.
106   8088              WriteVgaRegister:
107   8088 01 E0 03             LD      BC,$03E0
108   808B ED 79                OUT     (C),A
109   808D 7B                   LD      A,E
110   808E 0C                   INC     C
111   808F ED 79                OUT     (C),A
112   8091 C9                   RET
113   8092
114   8092              ; -------------------------------------------------------------------------
115   8092              ; Fill the 640x480x16 framebuffer.
116   8092              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
117   8092              ; The aperture C000h-FFFFh is switched with port 3DFh.
118   8092              ; -------------------------------------------------------------------------
119   8092              Fill640x480x16:
120   8092 AF                   XOR     A
121   8093 32 12 81             LD      (CurrentBank),A
122   8096
123   8096              FillBankLoop:
124   8096 3A 12 81             LD      A,(CurrentBank)
125   8099 01 DF 03             LD      BC,$03DF
126   809C ED 79                OUT     (C),A
127   809E
128   809E 21 00 C0             LD      HL,$C000
129   80A1 11 13 81             LD      DE,ColorPattern
130   80A4 3A 12 81             LD      A,(CurrentBank)
131   80A7 FE 25                CP      37
132   80A9 28 05                JR      Z,FillLastHalfBank
133   80AB 01 00 40             LD      BC,$4000
134   80AE 18 03                JR      FillBankBytes
135   80B0
136   80B0              FillLastHalfBank:
137   80B0 01 00 20             LD      BC,$2000
138   80B3
139   80B3              FillBankBytes:
140   80B3 1A                   LD      A,(DE)
141   80B4 13                   INC     DE
142   80B5 77                   LD      (HL),A
143   80B6 23                   INC     HL
144   80B7
145   80B7                      ; Repeat the 128-byte RGB565 colour-bar sequence.
146   80B7 F5                   PUSH    AF
147   80B8 7A                   LD      A,D
148   80B9 FE 81                CP      HIGH ColorPatternEnd
149   80BB 20 08                JR      NZ,PatternPointerReady
150   80BD 7B                   LD      A,E
151   80BE FE 93                CP      LOW ColorPatternEnd
152   80C0 20 03                JR      NZ,PatternPointerReady
153   80C2 11 13 81             LD      DE,ColorPattern
154   80C5              PatternPointerReady:
155   80C5 F1                   POP     AF
156   80C6
157   80C6 0B                   DEC     BC
158   80C7 78                   LD      A,B
159   80C8 B1                   OR      C
160   80C9 20 E8                JR      NZ,FillBankBytes
161   80CB
162   80CB 3A 12 81             LD      A,(CurrentBank)
163   80CE 3C                   INC     A
164   80CF 32 12 81             LD      (CurrentBank),A
165   80D2 FE 26                CP      38
166   80D4 20 C0                JR      NZ,FillBankLoop
167   80D6 C9                   RET
168   80D7
169   80D7              ; -------------------------------------------------------------------------
170   80D7              ; Readback checks:
171   80D7              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
172   80D7              ; bank 37 starts at linear offset 37*4000h = 5E000h.
173   80D7              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
174   80D7              ; Return A=0 on success, A=1 on mismatch.
175   80D7              ; -------------------------------------------------------------------------
176   80D7              VerifyFramebuffer:
177   80D7 AF                   XOR     A
178   80D8 01 DF 03             LD      BC,$03DF
179   80DB ED 79                OUT     (C),A
180   80DD
181   80DD 21 00 C0             LD      HL,$C000
182   80E0                      ; First eight pixels are black: bytes 0..15 must be zero.
183   80E0 7E                   LD      A,(HL)
184   80E1 B7                   OR      A
185   80E2 20 23                JR      NZ,VerifyFailed
186   80E4 23                   INC     HL
187   80E5 7E                   LD      A,(HL)
188   80E6 B7                   OR      A
189   80E7 20 1E                JR      NZ,VerifyFailed
190   80E9
191   80E9                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
192   80E9 21 10 C0             LD      HL,$C010
193   80EC 7E                   LD      A,(HL)
194   80ED FE 1F                CP      $1F
195   80EF 20 16                JR      NZ,VerifyFailed
196   80F1 23                   INC     HL
197   80F2 7E                   LD      A,(HL)
198   80F3 B7                   OR      A
199   80F4 20 11                JR      NZ,VerifyFailed
200   80F6
201   80F6 3E 25                LD      A,37
202   80F8 01 DF 03             LD      BC,$03DF
203   80FB ED 79                OUT     (C),A
204   80FD 21 FF DF             LD      HL,$DFFF
205   8100 7E                   LD      A,(HL)
206   8101 FE FF                CP      $FF
207   8103 20 02                JR      NZ,VerifyFailed
208   8105
209   8105 AF                   XOR     A
210   8106 C9                   RET
211   8107
212   8107              VerifyFailed:
213   8107 3E 01                LD      A,1
214   8109 C9                   RET
215   810A
216   810A              ; -------------------------------------------------------------------------
