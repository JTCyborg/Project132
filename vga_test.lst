 361  8276              ; -------------------------------------------------------------------------
 362  8276              ; Fill the 640x480x16 framebuffer.
 363  8276              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 364  8276              ; The aperture C000h-FFFFh is switched with port 3DFh.
 365  8276              ; -------------------------------------------------------------------------
 366  8276              Fill640x480x16:
 367  8276 AF                   XOR     A
 368  8277 32 F0 86             LD      (CurrentBank),A
 369  827A
 370  827A              FillBankLoop:
 371  827A 3A F0 86             LD      A,(CurrentBank)
 372  827D 01 DF 03             LD      BC,$03DF
 373  8280 ED 79                OUT     (C),A
 374  8282
 375  8282 21 00 C0             LD      HL,$C000
 376  8285 11 B8 8B             LD      DE,ColorPattern
 377  8288 3A F0 86             LD      A,(CurrentBank)
 378  828B FE 25                CP      37
 379  828D 28 05                JR      Z,FillLastHalfBank
 380  828F 01 00 40             LD      BC,$4000
 381  8292 18 03                JR      FillBankBytes
 382  8294
 383  8294              FillLastHalfBank:
 384  8294 01 00 20             LD      BC,$2000
 385  8297
 386  8297              FillBankBytes:
 387  8297 1A                   LD      A,(DE)
 388  8298 13                   INC     DE
 389  8299 77                   LD      (HL),A
 390  829A 23                   INC     HL
 391  829B
 392  829B                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 393  829B F5                   PUSH    AF
 394  829C 7A                   LD      A,D
 395  829D FE 8C                CP      HIGH ColorPatternEnd
 396  829F 20 08                JR      NZ,PatternPointerReady
 397  82A1 7B                   LD      A,E
 398  82A2 FE 38                CP      LOW ColorPatternEnd
 399  82A4 20 03                JR      NZ,PatternPointerReady
 400  82A6 11 B8 8B             LD      DE,ColorPattern
 401  82A9              PatternPointerReady:
 402  82A9 F1                   POP     AF
 403  82AA
 404  82AA 0B                   DEC     BC
 405  82AB 78                   LD      A,B
 406  82AC B1                   OR      C
 407  82AD 20 E8                JR      NZ,FillBankBytes
 408  82AF
 409  82AF 3A F0 86             LD      A,(CurrentBank)
 410  82B2 3C                   INC     A
 411  82B3 32 F0 86             LD      (CurrentBank),A
 412  82B6 FE 26                CP      38
 413  82B8 20 C0                JR      NZ,FillBankLoop
 414  82BA C9                   RET
 415  82BB
 416  82BB              ; -------------------------------------------------------------------------
 417  82BB              ; Readback checks:
 418  82BB              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 419  82BB              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 420  82BB              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 421  82BB              ; Return A=0 on success, A=1 on mismatch.
 422  82BB              ; -------------------------------------------------------------------------
 423  82BB              VerifyFramebuffer:
 424  82BB AF                   XOR     A
 425  82BC 01 DF 03             LD      BC,$03DF
 426  82BF ED 79                OUT     (C),A
 427  82C1
 428  82C1 21 00 C0             LD      HL,$C000
 429  82C4                      ; First eight pixels are black: bytes 0..15 must be zero.
 430  82C4 7E                   LD      A,(HL)
 431  82C5 B7                   OR      A
 432  82C6 20 23                JR      NZ,VerifyFailed
 433  82C8 23                   INC     HL
 434  82C9 7E                   LD      A,(HL)
 435  82CA B7                   OR      A
 436  82CB 20 1E                JR      NZ,VerifyFailed
 437  82CD
 438  82CD                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 439  82CD 21 10 C0             LD      HL,$C010
 440  82D0 7E                   LD      A,(HL)
 441  82D1 FE 1F                CP      $1F
 442  82D3 20 16                JR      NZ,VerifyFailed
 443  82D5 23                   INC     HL
 444  82D6 7E                   LD      A,(HL)
 445  82D7 B7                   OR      A
 446  82D8 20 11                JR      NZ,VerifyFailed
 447  82DA
 448  82DA 3E 25                LD      A,37
 449  82DC 01 DF 03             LD      BC,$03DF
 450  82DF ED 79                OUT     (C),A
 451  82E1 21 FF DF             LD      HL,$DFFF
 452  82E4 7E                   LD      A,(HL)
 453  82E5 FE FF                CP      $FF
 454  82E7 20 02                JR      NZ,VerifyFailed
 455  82E9
 456  82E9 AF                   XOR     A
 457  82EA C9                   RET
 458  82EB
 459  82EB              VerifyFailed:
 460  82EB 3E 01                LD      A,1
 461  82ED C9                   RET
 462  82EE
 463  82EE
 464  82EE              ; -------------------------------------------------------------------------
 465  82EE              ; Sweep every packed-pixel mode accepted by the Project131 1 MiB adapter.
 466  82EE              ; Supported combinations are taken from docs/ISA_VGA_Adapter.md.
 467  82EE              ; Each mode writes only its active framebuffer size. The final bank may
 468  82EE              ; be partially used; bytes outside the framebuffer are left untouched.
 469  82EE              ; -------------------------------------------------------------------------
 470  82EE              RunPackedModeSweep:
 471  82EE 21 0A 8D             LD      HL,MsgSweepStart
 472  82F1 CD E8 86             CALL    DebugPrint
 473  82F4 21 32 87             LD      HL,PackedModeTable
 474  82F7 22 F1 86             LD      (ModeTablePtr),HL
 475  82FA 21 9A 87             LD      HL,ModeLabelTable
 476  82FD 22 F3 86             LD      (ModeLabelPtr),HL
 477  8300 3E 0D                LD      A,13
 478  8302 32 F6 86             LD      (ModeCount),A
 479  8305 3E 01                LD      A,1
 480  8307 32 F5 86             LD      (ModeIndex),A
 481  830A
 482  830A              PackedModeNext:
 483  830A 2A F1 86             LD      HL,(ModeTablePtr)
 484  830D 7E                   LD      A,(HL)
 485  830E 23                   INC     HL
 486  830F 32 F7 86             LD      (ModeXLo),A
 487  8312 7E                   LD      A,(HL)
 488  8313 23                   INC     HL
 489  8314 32 F8 86             LD      (ModeXHi),A
 490  8317 7E                   LD      A,(HL)
 491  8318 23                   INC     HL
 492  8319 32 F9 86             LD      (ModeYLo),A
 493  831C 7E                   LD      A,(HL)
 494  831D 23                   INC     HL
 495  831E 32 FA 86             LD      (ModeYHi),A
 496  8321 7E                   LD      A,(HL)
 497  8322 23                   INC     HL
 498  8323 32 FB 86             LD      (ModeBpp),A
 499  8326 7E                   LD      A,(HL)
 500  8327 23                   INC     HL
 501  8328 32 FC 86             LD      (ModeBankCount),A
 502  832B 7E                   LD      A,(HL)
 503  832C 23                   INC     HL
 504  832D 32 FD 86             LD      (ModeLastBankBytes),A
 505  8330 7E                   LD      A,(HL)
 506  8331 23                   INC     HL
 507  8332 32 FE 86             LD      (ModeLastBankBytes+1),A
 508  8335 22 F1 86             LD      (ModeTablePtr),HL
 509  8338
 510  8338 3A F7 86             LD      A,(ModeXLo)
 511  833B 5F                   LD      E,A
 512  833C 3E 00                LD      A,0
 513  833E CD 6C 82             CALL    WriteVgaRegister
 514  8341 3A F8 86             LD      A,(ModeXHi)
 515  8344 5F                   LD      E,A
 516  8345 3E 01                LD      A,1
 517  8347 CD 6C 82             CALL    WriteVgaRegister
 518  834A 3A F9 86             LD      A,(ModeYLo)
 519  834D 5F                   LD      E,A
 520  834E 3E 02                LD      A,2
 521  8350 CD 6C 82             CALL    WriteVgaRegister
 522  8353 3A FA 86             LD      A,(ModeYHi)
 523  8356 5F                   LD      E,A
 524  8357 3E 03                LD      A,3
 525  8359 CD 6C 82             CALL    WriteVgaRegister
 526  835C 3A FB 86             LD      A,(ModeBpp)
 527  835F 5F                   LD      E,A
 528  8360 3E 04                LD      A,4
 529  8362 CD 6C 82             CALL    WriteVgaRegister
