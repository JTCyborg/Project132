530   8321              ; -------------------------------------------------------------------------
531   8321              ; Port EF text logger (ASCII bytes, same convention as Project112).
532   8321              ; -------------------------------------------------------------------------
533   8321              ; -------------------------------------------------------------------------
534   8321              ; Spectrum display and keyboard control.
535   8321              ; RST 10h is the Spectrum ROM PRINT-OUT entry (current channel #2).
536   8321              ; SPACE is bit 0 of keyboard row 7FFE, active low.
537   8321              ; -------------------------------------------------------------------------
538   8321              SpectrumPrint:
539   8321 7E                   LD      A,(HL)
540   8322 B7                   OR      A
541   8323 C8                   RET     Z
542   8324 D7                   RST     $10
543   8325 23                   INC     HL
544   8326 18 F9                JR      SpectrumPrint
