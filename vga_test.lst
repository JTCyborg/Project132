415   825A 7E                   LD      A,(HL)
416   825B B7                   OR      A
417   825C 28 3E                JR      Z,DrawBannerRowDone
418   825E 23                   INC     HL
419   825F 22 1C 83             LD      (DrawStringPtr),HL
420   8262
421   8262                      ; Font address = 3D00h + (ASCII - 20h) * 8 + scanline.
422   8262 D6 20                SUB     32
423   8264 6F                   LD      L,A
424   8265 26 00                LD      H,0
425   8267 29                   ADD     HL,HL
426   8268 29                   ADD     HL,HL
427   8269 29                   ADD     HL,HL
428   826A 11 00 3D             LD      DE,$3D00
429   826D 19                   ADD     HL,DE
430   826E 3A 12 83             LD      A,(DrawRow)
431   8271 5F                   LD      E,A
432   8272 16 00                LD      D,0
433   8274 19                   ADD     HL,DE
434   8275 7E                   LD      A,(HL)
435   8276 32 14 83             LD      (DrawGlyphBits),A
436   8279 3E 08                LD      A,8
437   827B 32 13 83             LD      (DrawPixelCount),A
