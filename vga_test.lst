# file opened: vga_test.asm
  1   0000              ; =========================================================================
  2   0000              ; PROJECT132 — ATM TURBO 2+ VGA ADAPTER TEST
  3   0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
  4   0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
  5   0000              ;
  6   0000              ; Test:
  7   0000              ;   - unlock ATM shadow ports through TR-DOS ROM
  8   0000              ;   - enable VGA software mode + 16 KiB aperture
  9   0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
 10   0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
 11   0000              ;   - read back bytes from bank 0 and the last framebuffer bank
 12   0000              ;   - report results on port EF (spectrum_out.txt)
 13   0000              ;
 14   0000              ; Expected image: eight-colour RGB565 vertical bars.
 15   0000              ; =========================================================================
 16   0000
 17   0000                      DEVICE ZXSPECTRUM128
 18   0000                      EMPTYTRD "vga_test.TRD"
 19   0000
 20   0000                      ORG     $8000
 21   8000
 22   8000              VgaTestEntry:
 23   8000 F3                   DI
 24   8001 31 FF BF             LD      SP,$BFFF
 25   8004
 26   8004                      ; ROM PRINT-OUT/CLS need the normal Spectrum interrupt environment.
 27   8004 FB                   EI
 28   8005 CD 33 83             CALL    SpectrumShowStartup
 29   8008
 30   8008 21 C9 87             LD      HL,MsgBuild
 31   800B CD AF 83             CALL    DebugPrint
 32   800E 21 E0 87             LD      HL,MsgStart
 33   8011 CD AF 83             CALL    DebugPrint
 34   8014
 35   8014 CD 7E 80             CALL    OpenATMShadowPorts
 36   8017
 37   8017 21 FD 87             LD      HL,MsgAdapterInit
 38   801A CD AF 83             CALL    DebugPrint
 39   801D
 40   801D                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
 41   801D 01 DE 03             LD      BC,$03DE
 42   8020 3E 03                LD      A,$03
 43   8022 ED 79                OUT     (C),A
 44   8024
 45   8024                      ; Configure packed-pixel 640x480 RGB565:
 46   8024                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
 47   8024 3E 00                LD      A,0
 48   8026 1E 80                LD      E,$80
 49   8028 CD 8F 80             CALL    WriteVgaRegister
 50   802B 3E 01                LD      A,1
 51   802D 1E 02                LD      E,$02
 52   802F CD 8F 80             CALL    WriteVgaRegister
 53   8032 3E 02                LD      A,2
 54   8034 1E E0                LD      E,$E0
 55   8036 CD 8F 80             CALL    WriteVgaRegister
 56   8039 3E 03                LD      A,3
 57   803B 1E 01                LD      E,$01
 58   803D CD 8F 80             CALL    WriteVgaRegister
 59   8040 3E 04                LD      A,4
 60   8042 1E 10                LD      E,16
 61   8044 CD 8F 80             CALL    WriteVgaRegister
 62   8047 3E 05                LD      A,5
 63   8049 1E 01                LD      E,1
 64   804B CD 8F 80             CALL    WriteVgaRegister
 65   804E
 66   804E 21 14 88             LD      HL,MsgModeSet
 67   8051 CD AF 83             CALL    DebugPrint
 68   8054
 69   8054 CD 99 80             CALL    Fill640x480x16
 70   8057
 71   8057 21 2E 88             LD      HL,MsgFrameWritten
 72   805A CD AF 83             CALL    DebugPrint
 73   805D
 74   805D CD DE 80             CALL    VerifyFramebuffer
 75   8060 B7                   OR      A
 76   8061 20 12                JR      NZ,VgaTestFailed
 77   8063
 78   8063 21 4A 88             LD      HL,MsgReadbackPass
 79   8066 CD AF 83             CALL    DebugPrint
 80   8069
 81   8069 CD 11 81             CALL    RunPackedModeSweep
 82   806C
 83   806C 21 74 88             LD      HL,MsgReady
 84   806F CD AF 83             CALL    DebugPrint
 85   8072
 86   8072              VgaTestIdle:
 87   8072 76                   HALT
 88   8073 18 FD                JR      VgaTestIdle
 89   8075
 90   8075              VgaTestFailed:
 91   8075 21 5F 88             LD      HL,MsgReadbackFail
 92   8078 CD AF 83             CALL    DebugPrint
 93   807B              VgaTestFailedIdle:
 94   807B 76                   HALT
 95   807C 18 FD                JR      VgaTestFailedIdle
 96   807E
 97   807E              ; -------------------------------------------------------------------------
 98   807E              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 99   807E              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
100   807E              ; -------------------------------------------------------------------------
101   807E              OpenATMShadowPorts:
102   807E 01 8E 80             LD      BC,ShadowPortsOpened
103   8081 C5                   PUSH    BC
104   8082 01 53 2A             LD      BC,$2A53
105   8085 C5                   PUSH    BC
106   8086 01 77 01             LD      BC,$0177
107   8089 3E C3                LD      A,$C3
108   808B C3 2F 3D             JP      $3D2F
109   808E              ShadowPortsOpened:
110   808E C9                   RET
111   808F
112   808F              ; A = indexed VGA register, E = value.
113   808F              WriteVgaRegister:
114   808F 01 E0 03             LD      BC,$03E0
115   8092 ED 79                OUT     (C),A
116   8094 7B                   LD      A,E
117   8095 0C                   INC     C
118   8096 ED 79                OUT     (C),A
119   8098 C9                   RET
120   8099
121   8099              ; -------------------------------------------------------------------------
122   8099              ; Fill the 640x480x16 framebuffer.
123   8099              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
124   8099              ; The aperture C000h-FFFFh is switched with port 3DFh.
125   8099              ; -------------------------------------------------------------------------
126   8099              Fill640x480x16:
127   8099 AF                   XOR     A
128   809A 32 B7 83             LD      (CurrentBank),A
129   809D
130   809D              FillBankLoop:
131   809D 3A B7 83             LD      A,(CurrentBank)
132   80A0 01 DF 03             LD      BC,$03DF
133   80A3 ED 79                OUT     (C),A
134   80A5
135   80A5 21 00 C0             LD      HL,$C000
136   80A8 11 49 87             LD      DE,ColorPattern
137   80AB 3A B7 83             LD      A,(CurrentBank)
138   80AE FE 25                CP      37
139   80B0 28 05                JR      Z,FillLastHalfBank
140   80B2 01 00 40             LD      BC,$4000
141   80B5 18 03                JR      FillBankBytes
142   80B7
143   80B7              FillLastHalfBank:
144   80B7 01 00 20             LD      BC,$2000
145   80BA
146   80BA              FillBankBytes:
147   80BA 1A                   LD      A,(DE)
148   80BB 13                   INC     DE
149   80BC 77                   LD      (HL),A
150   80BD 23                   INC     HL
151   80BE
152   80BE                      ; Repeat the 128-byte RGB565 colour-bar sequence.
153   80BE F5                   PUSH    AF
154   80BF 7A                   LD      A,D
155   80C0 FE 87                CP      HIGH ColorPatternEnd
156   80C2 20 08                JR      NZ,PatternPointerReady
157   80C4 7B                   LD      A,E
158   80C5 FE C9                CP      LOW ColorPatternEnd
159   80C7 20 03                JR      NZ,PatternPointerReady
160   80C9 11 49 87             LD      DE,ColorPattern
161   80CC              PatternPointerReady:
162   80CC F1                   POP     AF
163   80CD
164   80CD 0B                   DEC     BC
165   80CE 78                   LD      A,B
166   80CF B1                   OR      C
167   80D0 20 E8                JR      NZ,FillBankBytes
168   80D2
169   80D2 3A B7 83             LD      A,(CurrentBank)
170   80D5 3C                   INC     A
171   80D6 32 B7 83             LD      (CurrentBank),A
172   80D9 FE 26                CP      38
173   80DB 20 C0                JR      NZ,FillBankLoop
174   80DD C9                   RET
175   80DE
176   80DE              ; -------------------------------------------------------------------------
177   80DE              ; Readback checks:
178   80DE              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
179   80DE              ; bank 37 starts at linear offset 37*4000h = 5E000h.
180   80DE              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
181   80DE              ; Return A=0 on success, A=1 on mismatch.
182   80DE              ; -------------------------------------------------------------------------
183   80DE              VerifyFramebuffer:
184   80DE AF                   XOR     A
185   80DF 01 DF 03             LD      BC,$03DF
186   80E2 ED 79                OUT     (C),A
187   80E4
188   80E4 21 00 C0             LD      HL,$C000
189   80E7                      ; First eight pixels are black: bytes 0..15 must be zero.
190   80E7 7E                   LD      A,(HL)
191   80E8 B7                   OR      A
192   80E9 20 23                JR      NZ,VerifyFailed
193   80EB 23                   INC     HL
194   80EC 7E                   LD      A,(HL)
195   80ED B7                   OR      A
196   80EE 20 1E                JR      NZ,VerifyFailed
197   80F0
198   80F0                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
199   80F0 21 10 C0             LD      HL,$C010
200   80F3 7E                   LD      A,(HL)
201   80F4 FE 1F                CP      $1F
202   80F6 20 16                JR      NZ,VerifyFailed
203   80F8 23                   INC     HL
204   80F9 7E                   LD      A,(HL)
205   80FA B7                   OR      A
206   80FB 20 11                JR      NZ,VerifyFailed
207   80FD
208   80FD 3E 25                LD      A,37
209   80FF 01 DF 03             LD      BC,$03DF
210   8102 ED 79                OUT     (C),A
211   8104 21 FF DF             LD      HL,$DFFF
212   8107 7E                   LD      A,(HL)
213   8108 FE FF                CP      $FF
214   810A 20 02                JR      NZ,VerifyFailed
215   810C
216   810C AF                   XOR     A
217   810D C9                   RET
218   810E
219   810E              VerifyFailed:
220   810E 3E 01                LD      A,1
221   8110 C9                   RET
222   8111
223   8111
224   8111              ; -------------------------------------------------------------------------
225   8111              ; Sweep every packed-pixel mode accepted by the Project131 1 MiB adapter.
226   8111              ; Supported combinations are taken from docs/ISA_VGA_Adapter.md.
227   8111              ; Each mode is selected, the entire 1 MiB aperture is written, then held
228   8111              ; briefly so the VGA window can be inspected before advancing.
229   8111              ; -------------------------------------------------------------------------
230   8111              RunPackedModeSweep:
231   8111 21 9B 88             LD      HL,MsgSweepStart
232   8114 CD AF 83             CALL    DebugPrint
233   8117 21 E0 83             LD      HL,PackedModeTable
234   811A 22 B8 83             LD      (ModeTablePtr),HL
235   811D 21 21 84             LD      HL,ModeLabelTable
236   8120 22 BA 83             LD      (ModeLabelPtr),HL
237   8123 3E 0D                LD      A,13
238   8125 32 BD 83             LD      (ModeCount),A
239   8128 3E 01                LD      A,1
240   812A 32 BC 83             LD      (ModeIndex),A
241   812D
242   812D              PackedModeNext:
243   812D 2A B8 83             LD      HL,(ModeTablePtr)
244   8130 7E                   LD      A,(HL)
245   8131 23                   INC     HL
246   8132 32 BE 83             LD      (ModeXLo),A
247   8135 7E                   LD      A,(HL)
248   8136 23                   INC     HL
249   8137 32 BF 83             LD      (ModeXHi),A
250   813A 7E                   LD      A,(HL)
251   813B 23                   INC     HL
252   813C 32 C0 83             LD      (ModeYLo),A
253   813F 7E                   LD      A,(HL)
254   8140 23                   INC     HL
255   8141 32 C1 83             LD      (ModeYHi),A
256   8144 7E                   LD      A,(HL)
257   8145 23                   INC     HL
258   8146 32 C2 83             LD      (ModeBpp),A
259   8149 22 B8 83             LD      (ModeTablePtr),HL
260   814C
261   814C 3A BE 83             LD      A,(ModeXLo)
262   814F 5F                   LD      E,A
263   8150 3E 00                LD      A,0
264   8152 CD 8F 80             CALL    WriteVgaRegister
265   8155 3A BF 83             LD      A,(ModeXHi)
266   8158 5F                   LD      E,A
267   8159 3E 01                LD      A,1
268   815B CD 8F 80             CALL    WriteVgaRegister
269   815E 3A C0 83             LD      A,(ModeYLo)
270   8161 5F                   LD      E,A
271   8162 3E 02                LD      A,2
272   8164 CD 8F 80             CALL    WriteVgaRegister
273   8167 3A C1 83             LD      A,(ModeYHi)
274   816A 5F                   LD      E,A
275   816B 3E 03                LD      A,3
276   816D CD 8F 80             CALL    WriteVgaRegister
277   8170 3A C2 83             LD      A,(ModeBpp)
278   8173 5F                   LD      E,A
279   8174 3E 04                LD      A,4
280   8176 CD 8F 80             CALL    WriteVgaRegister
281   8179 3E 05                LD      A,5
282   817B 1E 01                LD      E,1
283   817D CD 8F 80             CALL    WriteVgaRegister
284   8180
285   8180 21 BA 88             LD      HL,MsgModePrefix
286   8183 CD AF 83             CALL    DebugPrint
287   8186 3A BF 83             LD      A,(ModeXHi)
288   8189 CD 0E 83             CALL    DebugHexByte
289   818C 3A BE 83             LD      A,(ModeXLo)
290   818F CD 0E 83             CALL    DebugHexByte
291   8192 3E 78                LD      A,'x'
292   8194 D3 EF                OUT     ($EF),A
293   8196 3A C1 83             LD      A,(ModeYHi)
294   8199 CD 0E 83             CALL    DebugHexByte
295   819C 3A C0 83             LD      A,(ModeYLo)
296   819F CD 0E 83             CALL    DebugHexByte
297   81A2 3E 20                LD      A,' '
298   81A4 D3 EF                OUT     ($EF),A
299   81A6 3A C2 83             LD      A,(ModeBpp)
300   81A9 CD 0E 83             CALL    DebugHexByte
301   81AC 21 C0 88             LD      HL,MsgBppSuffix
302   81AF CD AF 83             CALL    DebugPrint
303   81B2
304   81B2                      ; Show the selected mode BEFORE the long 1 MiB VRAM fill.
305   81B2 CD 43 83             CALL    SpectrumShowMode
306   81B5 CD E5 81             CALL    FillModeVRAM
307   81B8 CD 6F 83             CALL    SpectrumShowWriteComplete
308   81BB                      ; Do not change mode until the user presses and releases SPACE.
309   81BB CD 9F 83             CALL    WaitSpace
310   81BE
311   81BE 3A BC 83             LD      A,(ModeIndex)
312   81C1 3C                   INC     A
313   81C2 32 BC 83             LD      (ModeIndex),A
314   81C5
315   81C5 3A BD 83             LD      A,(ModeCount)
316   81C8 3D                   DEC     A
317   81C9 32 BD 83             LD      (ModeCount),A
318   81CC C2 2D 81             JP      NZ,PackedModeNext
319   81CF 21 D3 88             LD      HL,MsgSweepDone
320   81D2 CD AF 83             CALL    DebugPrint
321   81D5 CD 2F 83             CALL    SpectrumClear
322   81D8 21 F1 88             LD      HL,ScreenTitle
323   81DB CD 28 83             CALL    SpectrumPrint
324   81DE 21 BD 89             LD      HL,ScreenAllDone
325   81E1 CD 28 83             CALL    SpectrumPrint
326   81E4 C9                   RET
327   81E5
328   81E5              ; Fill 1 MiB with a repeating RGB/index-friendly byte pattern.
329   81E5              ; All 64 banks are written so the test covers the full VRAM aperture.
330   81E5              FillModeVRAM:
331   81E5 AF                   XOR     A
332   81E6 32 B7 83             LD      (CurrentBank),A
333   81E9              ModeFillBank:
334   81E9 3A B7 83             LD      A,(CurrentBank)
335   81EC 01 DF 03             LD      BC,$03DF
336   81EF ED 79                OUT     (C),A
337   81F1 21 00 C0             LD      HL,$C000
338   81F4 11 D0 83             LD      DE,ModePattern
339   81F7 01 00 40             LD      BC,$4000
340   81FA              ModeFillByte:
341   81FA 1A                   LD      A,(DE)
342   81FB 13                   INC     DE
343   81FC 77                   LD      (HL),A
344   81FD 23                   INC     HL
345   81FE 7A                   LD      A,D
346   81FF FE 83                CP      HIGH ModePatternEnd
347   8201 20 08                JR      NZ,ModePatternReady
348   8203 7B                   LD      A,E
349   8204 FE E0                CP      LOW ModePatternEnd
350   8206 20 03                JR      NZ,ModePatternReady
351   8208 11 D0 83             LD      DE,ModePattern
352   820B              ModePatternReady:
353   820B 0B                   DEC     BC
354   820C 78                   LD      A,B
355   820D B1                   OR      C
356   820E 20 EA                JR      NZ,ModeFillByte
357   8210 3A B7 83             LD      A,(CurrentBank)
358   8213 3C                   INC     A
359   8214 32 B7 83             LD      (CurrentBank),A
360   8217 FE 40                CP      64
361   8219 20 CE                JR      NZ,ModeFillBank
362   821B C9                   RET
363   821C
364   821C              ModeHoldDelay:
365   821C 11 FF FF             LD      DE,$FFFF
366   821F              ModeHoldLoop:
367   821F 1B                   DEC     DE
368   8220 7A                   LD      A,D
369   8221 B3                   OR      E
370   8222 20 FB                JR      NZ,ModeHoldLoop
371   8224 C9                   RET
372   8225
373   8225              ; -------------------------------------------------------------------------
374   8225              ; Draw "P132 VGA TEST" with the Spectrum ROM character set.
375   8225              ; The standard 8x8 ROM font starts at 3D00h (character 32).
376   8225              ; Draws one 104-pixel line at the top of bank 0. The chosen modes keep
377   8225              ; the complete 8 scanlines inside the first 16 KiB aperture bank.
378   8225              ; -------------------------------------------------------------------------
379   8225              DrawSpectrumBanner:
380   8225                      ; Select framebuffer bank zero.
381   8225 AF                   XOR     A
382   8226 01 DF 03             LD      BC,$03DF
383   8229 ED 79                OUT     (C),A
384   822B
385   822B                      ; Bytes per pixel: ceil(BPP/8).
386   822B 3A C2 83             LD      A,(ModeBpp)
387   822E FE 08                CP      8
388   8230 3E 01                LD      A,1
389   8232 28 18                JR      Z,DrawBytesReady
390   8234 3A C2 83             LD      A,(ModeBpp)
391   8237 FE 10                CP      16
392   8239 3E 02                LD      A,2
393   823B 38 0F                JR      C,DrawBytesReady
394   823D 28 0D                JR      Z,DrawBytesReady
395   823F 3A C2 83             LD      A,(ModeBpp)
396   8242 FE 18                CP      24
397   8244 3E 03                LD      A,3
398   8246 38 04                JR      C,DrawBytesReady
399   8248 28 02                JR      Z,DrawBytesReady
400   824A 3E 04                LD      A,4
401   824C              DrawBytesReady:
402   824C 32 C3 83             LD      (DrawBytes),A
403   824F
404   824F                      ; Calculate pitch = X resolution * bytes per pixel.
405   824F 3A BE 83             LD      A,(ModeXLo)
406   8252 6F                   LD      L,A
407   8253 3A BF 83             LD      A,(ModeXHi)
408   8256 67                   LD      H,A
409   8257 EB                   EX      DE,HL
410   8258 21 00 00             LD      HL,0
411   825B 3A C3 83             LD      A,(DrawBytes)
412   825E              DrawPitchLoop:
413   825E 19                   ADD     HL,DE
414   825F 3D                   DEC     A
415   8260 20 FC                JR      NZ,DrawPitchLoop
416   8262 22 C8 83             LD      (DrawPitch),HL
417   8265
418   8265 AF                   XOR     A
419   8266 32 C4 83             LD      (DrawRow),A
420   8269 32 CA 83             LD      (DrawRowBase),A
421   826C 32 CB 83             LD      (DrawRowBase+1),A
422   826F
423   826F              DrawBannerRow:
424   826F                      ; Start this scanline at C000h + row * pitch.
425   826F 2A CA 83             LD      HL,(DrawRowBase)
426   8272 11 00 C0             LD      DE,$C000
427   8275 19                   ADD     HL,DE
428   8276 22 CC 83             LD      (DrawPixelPtr),HL
429   8279 21 00 83             LD      HL,DrawBannerText
430   827C 22 CE 83             LD      (DrawStringPtr),HL
431   827F
432   827F              DrawBannerChar:
433   827F 2A CE 83             LD      HL,(DrawStringPtr)
434   8282 7E                   LD      A,(HL)
435   8283 B7                   OR      A
436   8284 28 3E                JR      Z,DrawBannerRowDone
437   8286 23                   INC     HL
438   8287 22 CE 83             LD      (DrawStringPtr),HL
439   828A
440   828A                      ; Font address = 3D00h + (ASCII - 20h) * 8 + scanline.
441   828A D6 20                SUB     32
442   828C 6F                   LD      L,A
443   828D 26 00                LD      H,0
444   828F 29                   ADD     HL,HL
445   8290 29                   ADD     HL,HL
446   8291 29                   ADD     HL,HL
447   8292 11 00 3D             LD      DE,$3D00
448   8295 19                   ADD     HL,DE
449   8296 3A C4 83             LD      A,(DrawRow)
450   8299 5F                   LD      E,A
451   829A 16 00                LD      D,0
452   829C 19                   ADD     HL,DE
453   829D 7E                   LD      A,(HL)
454   829E 32 C6 83             LD      (DrawGlyphBits),A
455   82A1 3E 08                LD      A,8
456   82A3 32 C5 83             LD      (DrawPixelCount),A
457   82A6
458   82A6              DrawBannerPixel:
459   82A6 3A C6 83             LD      A,(DrawGlyphBits)
460   82A9 07                   RLCA
461   82AA 32 C6 83             LD      (DrawGlyphBits),A
462   82AD 3E 00                LD      A,0
463   82AF 30 02                JR      NC,DrawBannerPixelInkReady
464   82B1 3E 01                LD      A,1
465   82B3              DrawBannerPixelInkReady:
466   82B3 32 C7 83             LD      (DrawInk),A
467   82B6 CD DB 82             CALL    DrawBannerPutPixel
468   82B9 3A C5 83             LD      A,(DrawPixelCount)
469   82BC 3D                   DEC     A
470   82BD 32 C5 83             LD      (DrawPixelCount),A
471   82C0 20 E4                JR      NZ,DrawBannerPixel
472   82C2 18 BB                JR      DrawBannerChar
473   82C4
474   82C4              DrawBannerRowDone:
475   82C4 2A CA 83             LD      HL,(DrawRowBase)
476   82C7 ED 5B C8 83          LD      DE,(DrawPitch)
477   82CB 19                   ADD     HL,DE
478   82CC 22 CA 83             LD      (DrawRowBase),HL
479   82CF 3A C4 83             LD      A,(DrawRow)
480   82D2 3C                   INC     A
481   82D3 32 C4 83             LD      (DrawRow),A
482   82D6 FE 08                CP      8
483   82D8 20 95                JR      NZ,DrawBannerRow
484   82DA C9                   RET
485   82DB
486   82DB              ; Write one foreground/background pixel and advance the linear pointer.
487   82DB              DrawBannerPutPixel:
488   82DB 2A CC 83             LD      HL,(DrawPixelPtr)
489   82DE 3A C7 83             LD      A,(DrawInk)
490   82E1 B7                   OR      A
491   82E2 28 0D                JR      Z,DrawBannerBackground
492   82E4 3A C2 83             LD      A,(ModeBpp)
493   82E7 FE 08                CP      8
494   82E9 3E FF                LD      A,$FF
495   82EB 20 05                JR      NZ,DrawBannerPixelValueReady
496   82ED 3E 0F                LD      A,$0F               ; EGA palette entry 15 = white.
497   82EF 18 01                JR      DrawBannerPixelValueReady
498   82F1              DrawBannerBackground:
499   82F1 AF                   XOR     A
500   82F2              DrawBannerPixelValueReady:
501   82F2 4F                   LD      C,A
502   82F3 3A C3 83             LD      A,(DrawBytes)
503   82F6 47                   LD      B,A
504   82F7 79                   LD      A,C
505   82F8              DrawBannerPutPixelByte:
506   82F8 77                   LD      (HL),A
507   82F9 23                   INC     HL
508   82FA 10 FC                DJNZ    DrawBannerPutPixelByte
509   82FC 22 CC 83             LD      (DrawPixelPtr),HL
510   82FF C9                   RET
511   8300
512   8300              DrawBannerText:
513   8300 50 31 33 32          DEFM    "P132 VGA TEST",0
513   8304 20 56 47 41
513   8308 20 54 45 53
513   830C 54 00
514   830E
515   830E              DebugHexByte:
516   830E F5                   PUSH    AF
517   830F 0F                   RRCA
518   8310 0F                   RRCA
519   8311 0F                   RRCA
520   8312 0F                   RRCA
521   8313 CD 1B 83             CALL    DebugHexNibble
522   8316 F1                   POP     AF
523   8317 CD 1B 83             CALL    DebugHexNibble
524   831A C9                   RET
525   831B              DebugHexNibble:
526   831B E6 0F                AND     $0F
527   831D C6 30                ADD     A,'0'
528   831F FE 3A                CP      '9'+1
529   8321 38 02                JR      C,DebugHexOut
530   8323 C6 07                ADD     A,7
