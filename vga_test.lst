 323  8248              ; A = 2D register index, E = value.
 324  8248              Write2DRegister:
 325  8248 01 E2 03             LD      BC,$03E2
 326  824B ED 79                OUT     (C),A
 327  824D 0C                   INC     C
 328  824E 7B                   LD      A,E
 329  824F ED 79                OUT     (C),A
 330  8251 C9                   RET
 331  8252
 332  8252              ; A = 2D register index, returns value in A.
 333  8252              Read2DRegister:
