368   821E              ; -------------------------------------------------------------------------
369   821E              ; Draw "P132 VGA TEST" with the Spectrum ROM character set.
370   821E              ; The standard 8x8 ROM font starts at 3D00h (character 32).
371   821E              ; Draws one 104-pixel line at the top of bank 0. The chosen modes keep
372   821E              ; the complete 8 scanlines inside the first 16 KiB aperture bank.
373   821E              ; -------------------------------------------------------------------------
374   821E              DrawSpectrumBanner:
375   821E                      ; Select framebuffer bank zero.
376   821E AF                   XOR     A
377   821F 01 DF 03             LD      BC,$03DF
378   8222 ED 79                OUT     (C),A
379   8224
380   8224                      ; Bytes per pixel: ceil(BPP/8).
381   8224 3A 81 83             LD      A,(ModeBpp)
382   8227 FE 08                CP      8
383   8229 3E 01                LD      A,1
384   822B 28 18                JR      Z,DrawBytesReady
385   822D 3A 81 83             LD      A,(ModeBpp)
386   8230 FE 10                CP      16
387   8232 3E 02                LD      A,2
388   8234 38 0F                JR      C,DrawBytesReady
389   8236 28 0D                JR      Z,DrawBytesReady
390   8238 3A 81 83             LD      A,(ModeBpp)
391   823B FE 18                CP      24
392   823D 3E 03                LD      A,3
393   823F 38 04                JR      C,DrawBytesReady
394   8241 28 02                JR      Z,DrawBytesReady
395   8243 3E 04                LD      A,4
396   8245              DrawBytesReady:
397   8245 32 82 83             LD      (DrawBytes),A
398   8248
399   8248                      ; Calculate pitch = X resolution * bytes per pixel.
400   8248 3A 7D 83             LD      A,(ModeXLo)
401   824B 6F                   LD      L,A
402   824C 3A 7E 83             LD      A,(ModeXHi)
403   824F 67                   LD      H,A
404   8250 EB                   EX      DE,HL
405   8251 21 00 00             LD      HL,0
406   8254 3A 82 83             LD      A,(DrawBytes)
407   8257              DrawPitchLoop:
408   8257 19                   ADD     HL,DE
409   8258 3D                   DEC     A
410   8259 20 FC                JR      NZ,DrawPitchLoop
411   825B 22 87 83             LD      (DrawPitch),HL
412   825E
413   825E AF                   XOR     A
414   825F 32 83 83             LD      (DrawRow),A
415   8262 32 89 83             LD      (DrawRowBase),A
416   8265 32 8A 83             LD      (DrawRowBase+1),A
417   8268
418   8268              DrawBannerRow:
419   8268                      ; Start this scanline at C000h + row * pitch.
420   8268 2A 89 83             LD      HL,(DrawRowBase)
421   826B 11 00 C0             LD      DE,$C000
422   826E 19                   ADD     HL,DE
423   826F 22 8B 83             LD      (DrawPixelPtr),HL
424   8272 21 F9 82             LD      HL,DrawBannerText
425   8275 22 8D 83             LD      (DrawStringPtr),HL
426   8278
427   8278              DrawBannerChar:
428   8278 2A 8D 83             LD      HL,(DrawStringPtr)
429   827B 7E                   LD      A,(HL)
430   827C B7                   OR      A
431   827D 28 3E                JR      Z,DrawBannerRowDone
432   827F 23                   INC     HL
433   8280 22 8D 83             LD      (DrawStringPtr),HL
434   8283
435   8283                      ; Font address = 3D00h + (ASCII - 20h) * 8 + scanline.
436   8283 D6 20                SUB     32
437   8285 6F                   LD      L,A
438   8286 26 00                LD      H,0
439   8288 29                   ADD     HL,HL
440   8289 29                   ADD     HL,HL
441   828A 29                   ADD     HL,HL
442   828B 11 00 3D             LD      DE,$3D00
443   828E 19                   ADD     HL,DE
444   828F 3A 83 83             LD      A,(DrawRow)
445   8292 5F                   LD      E,A
446   8293 16 00                LD      D,0
447   8295 19                   ADD     HL,DE
448   8296 7E                   LD      A,(HL)
449   8297 32 85 83             LD      (DrawGlyphBits),A
450   829A 3E 08                LD      A,8
451   829C 32 84 83             LD      (DrawPixelCount),A
452   829F
453   829F              DrawBannerPixel:
454   829F 3A 85 83             LD      A,(DrawGlyphBits)
455   82A2 07                   RLCA
456   82A3 32 85 83             LD      (DrawGlyphBits),A
457   82A6 3E 00                LD      A,0
458   82A8 30 02                JR      NC,DrawBannerPixelInkReady
459   82AA 3E 01                LD      A,1
460   82AC              DrawBannerPixelInkReady:
461   82AC 32 86 83             LD      (DrawInk),A
462   82AF CD D4 82             CALL    DrawBannerPutPixel
463   82B2 3A 84 83             LD      A,(DrawPixelCount)
464   82B5 3D                   DEC     A
465   82B6 32 84 83             LD      (DrawPixelCount),A
466   82B9 20 E4                JR      NZ,DrawBannerPixel
467   82BB 18 BB                JR      DrawBannerChar
468   82BD
469   82BD              DrawBannerRowDone:
470   82BD 2A 89 83             LD      HL,(DrawRowBase)
471   82C0 ED 5B 87 83          LD      DE,(DrawPitch)
472   82C4 19                   ADD     HL,DE
473   82C5 22 89 83             LD      (DrawRowBase),HL
474   82C8 3A 83 83             LD      A,(DrawRow)
475   82CB 3C                   INC     A
476   82CC 32 83 83             LD      (DrawRow),A
477   82CF FE 08                CP      8
478   82D1 20 95                JR      NZ,DrawBannerRow
479   82D3 C9                   RET
480   82D4
481   82D4              ; Write one foreground/background pixel and advance the linear pointer.
482   82D4              DrawBannerPutPixel:
483   82D4 2A 8B 83             LD      HL,(DrawPixelPtr)
484   82D7 3A 86 83             LD      A,(DrawInk)
485   82DA B7                   OR      A
486   82DB 28 0D                JR      Z,DrawBannerBackground
487   82DD 3A 81 83             LD      A,(ModeBpp)
488   82E0 FE 08                CP      8
489   82E2 3E FF                LD      A,$FF
490   82E4 20 05                JR      NZ,DrawBannerPixelValueReady
491   82E6 3E 0F                LD      A,$0F               ; EGA palette entry 15 = white.
492   82E8 18 01                JR      DrawBannerPixelValueReady
493   82EA              DrawBannerBackground:
494   82EA AF                   XOR     A
495   82EB              DrawBannerPixelValueReady:
496   82EB 4F                   LD      C,A
497   82EC 3A 82 83             LD      A,(DrawBytes)
498   82EF 47                   LD      B,A
499   82F0 79                   LD      A,C
