354   81FD              ; -------------------------------------------------------------------------
355   81FD              ; Draw "P132 VGA TEST" with the Spectrum ROM character set.
356   81FD              ; The standard 8x8 ROM font starts at 3D00h (character 32).
357   81FD              ; Draws one 104-pixel line at the top of bank 0. The chosen modes keep
358   81FD              ; the complete 8 scanlines inside the first 16 KiB aperture bank.
359   81FD              ; -------------------------------------------------------------------------
360   81FD              DrawSpectrumBanner:
361   81FD                      ; Select framebuffer bank zero.
362   81FD AF                   XOR     A
363   81FE 01 DF 03             LD      BC,$03DF
364   8201 ED 79                OUT     (C),A
365   8203
366   8203                      ; Bytes per pixel: ceil(BPP/8).
367   8203 3A 10 83             LD      A,(ModeBpp)
368   8206 FE 08                CP      8
369   8208 3E 01                LD      A,1
370   820A 28 18                JR      Z,DrawBytesReady
371   820C 3A 10 83             LD      A,(ModeBpp)
372   820F FE 10                CP      16
373   8211 3E 02                LD      A,2
374   8213 38 0F                JR      C,DrawBytesReady
375   8215 28 0D                JR      Z,DrawBytesReady
376   8217 3A 10 83             LD      A,(ModeBpp)
377   821A FE 18                CP      24
378   821C 3E 03                LD      A,3
379   821E 38 04                JR      C,DrawBytesReady
380   8220 28 02                JR      Z,DrawBytesReady
381   8222 3E 04                LD      A,4
382   8224              DrawBytesReady:
383   8224 32 11 83             LD      (DrawBytes),A
384   8227
385   8227                      ; Calculate pitch = X resolution * bytes per pixel.
386   8227 3A 0C 83             LD      A,(ModeXLo)
387   822A 6F                   LD      L,A
388   822B 3A 0D 83             LD      A,(ModeXHi)
389   822E 67                   LD      H,A
390   822F EB                   EX      DE,HL
391   8230 21 00 00             LD      HL,0
392   8233 3A 11 83             LD      A,(DrawBytes)
393   8236              DrawPitchLoop:
394   8236 19                   ADD     HL,DE
395   8237 3D                   DEC     A
396   8238 20 FC                JR      NZ,DrawPitchLoop
397   823A 22 16 83             LD      (DrawPitch),HL
398   823D
399   823D AF                   XOR     A
400   823E 32 12 83             LD      (DrawRow),A
401   8241 32 18 83             LD      (DrawRowBase),A
402   8244 32 19 83             LD      (DrawRowBase+1),A
403   8247
404   8247              DrawBannerRow:
405   8247                      ; Start this scanline at C000h + row * pitch.
406   8247 2A 18 83             LD      HL,(DrawRowBase)
407   824A 11 00 C0             LD      DE,$C000
408   824D 19                   ADD     HL,DE
409   824E 22 1A 83             LD      (DrawPixelPtr),HL
410   8251 21 D8 82             LD      HL,DrawBannerText
411   8254 22 1C 83             LD      (DrawStringPtr),HL
412   8257
413   8257              DrawBannerChar:
