300   81AE CD DE 81             CALL    FillModeVRAM
301   81B1
302   81B1                      ; Show the exact active test on the Spectrum screen and wait for SPACE.
303   81B1 CD 2C 83             CALL    SpectrumShowMode
304   81B4 CD 5E 83             CALL    WaitSpace
305   81B7
306   81B7 3A 7B 83             LD      A,(ModeIndex)
307   81BA 3C                   INC     A
308   81BB 32 7B 83             LD      (ModeIndex),A
309   81BE
310   81BE 3A 7C 83             LD      A,(ModeCount)
311   81C1 3D                   DEC     A
312   81C2 32 7C 83             LD      (ModeCount),A
313   81C5 C2 29 81             JP      NZ,PackedModeNext
314   81C8 21 C6 86             LD      HL,MsgSweepDone
