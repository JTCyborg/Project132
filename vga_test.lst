377   822B              ; -------------------------------------------------------------------------
378   822B              ; Draw "P132 VGA TEST" with the Spectrum ROM character set.
379   822B              ; The standard 8x8 ROM font starts at 3D00h (character 32).
380   822B              ; Draws one 104-pixel line at the top of bank 0. The chosen modes keep
381   822B              ; the complete 8 scanlines inside the first 16 KiB aperture bank.
382   822B              ; -------------------------------------------------------------------------
383   822B              DrawSpectrumBanner:
384   822B                      ; Select framebuffer bank zero.
385   822B AF                   XOR     A
386   822C 01 DF 03             LD      BC,$03DF
387   822F ED 79                OUT     (C),A
388   8231
389   8231                      ; Bytes per pixel: ceil(BPP/8).
390   8231 3A 00 84             LD      A,(ModeBpp)
391   8234 FE 08                CP      8
392   8236 3E 01                LD      A,1
393   8238 28 18                JR      Z,DrawBytesReady
394   823A 3A 00 84             LD      A,(ModeBpp)
395   823D FE 10                CP      16
396   823F 3E 02                LD      A,2
397   8241 38 0F                JR      C,DrawBytesReady
398   8243 28 0D                JR      Z,DrawBytesReady
399   8245 3A 00 84             LD      A,(ModeBpp)
400   8248 FE 18                CP      24
401   824A 3E 03                LD      A,3
402   824C 38 04                JR      C,DrawBytesReady
403   824E 28 02                JR      Z,DrawBytesReady
404   8250 3E 04                LD      A,4
405   8252              DrawBytesReady:
406   8252 32 01 84             LD      (DrawBytes),A
407   8255
408   8255                      ; Calculate pitch = X resolution * bytes per pixel.
409   8255 3A FC 83             LD      A,(ModeXLo)
410   8258 6F                   LD      L,A
411   8259 3A FD 83             LD      A,(ModeXHi)
412   825C 67                   LD      H,A
413   825D EB                   EX      DE,HL
414   825E 21 00 00             LD      HL,0
415   8261 3A 01 84             LD      A,(DrawBytes)
416   8264              DrawPitchLoop:
417   8264 19                   ADD     HL,DE
418   8265 3D                   DEC     A
419   8266 20 FC                JR      NZ,DrawPitchLoop
420   8268 22 06 84             LD      (DrawPitch),HL
421   826B
422   826B AF                   XOR     A
423   826C 32 02 84             LD      (DrawRow),A
424   826F 32 08 84             LD      (DrawRowBase),A
425   8272 32 09 84             LD      (DrawRowBase+1),A
426   8275
427   8275              DrawBannerRow:
428   8275                      ; Start this scanline at C000h + row * pitch.
429   8275 2A 08 84             LD      HL,(DrawRowBase)
430   8278 11 00 C0             LD      DE,$C000
431   827B 19                   ADD     HL,DE
432   827C 22 0A 84             LD      (DrawPixelPtr),HL
433   827F 21 06 83             LD      HL,DrawBannerText
434   8282 22 0C 84             LD      (DrawStringPtr),HL
435   8285
436   8285              DrawBannerChar:
437   8285 2A 0C 84             LD      HL,(DrawStringPtr)
438   8288 7E                   LD      A,(HL)
439   8289 B7                   OR      A
440   828A 28 3E                JR      Z,DrawBannerRowDone
441   828C 23                   INC     HL
442   828D 22 0C 84             LD      (DrawStringPtr),HL
443   8290
444   8290                      ; Font address = 3D00h + (ASCII - 20h) * 8 + scanline.
445   8290 D6 20                SUB     32
446   8292 6F                   LD      L,A
447   8293 26 00                LD      H,0
448   8295 29                   ADD     HL,HL
449   8296 29                   ADD     HL,HL
450   8297 29                   ADD     HL,HL
451   8298 11 00 3D             LD      DE,$3D00
452   829B 19                   ADD     HL,DE
453   829C 3A 02 84             LD      A,(DrawRow)
454   829F 5F                   LD      E,A
455   82A0 16 00                LD      D,0
456   82A2 19                   ADD     HL,DE
457   82A3 7E                   LD      A,(HL)
458   82A4 32 04 84             LD      (DrawGlyphBits),A
459   82A7 3E 08                LD      A,8
460   82A9 32 03 84             LD      (DrawPixelCount),A
461   82AC
462   82AC              DrawBannerPixel:
463   82AC 3A 04 84             LD      A,(DrawGlyphBits)
464   82AF 07                   RLCA
465   82B0 32 04 84             LD      (DrawGlyphBits),A
466   82B3 3E 00                LD      A,0
467   82B5 30 02                JR      NC,DrawBannerPixelInkReady
468   82B7 3E 01                LD      A,1
469   82B9              DrawBannerPixelInkReady:
470   82B9 32 05 84             LD      (DrawInk),A
471   82BC CD E1 82             CALL    DrawBannerPutPixel
472   82BF 3A 03 84             LD      A,(DrawPixelCount)
473   82C2 3D                   DEC     A
474   82C3 32 03 84             LD      (DrawPixelCount),A
475   82C6 20 E4                JR      NZ,DrawBannerPixel
476   82C8 18 BB                JR      DrawBannerChar
477   82CA
478   82CA              DrawBannerRowDone:
479   82CA 2A 08 84             LD      HL,(DrawRowBase)
480   82CD ED 5B 06 84          LD      DE,(DrawPitch)
481   82D1 19                   ADD     HL,DE
482   82D2 22 08 84             LD      (DrawRowBase),HL
483   82D5 3A 02 84             LD      A,(DrawRow)
484   82D8 3C                   INC     A
485   82D9 32 02 84             LD      (DrawRow),A
486   82DC FE 08                CP      8
487   82DE 20 95                JR      NZ,DrawBannerRow
488   82E0 C9                   RET
489   82E1
490   82E1              ; Write one foreground/background pixel and advance the linear pointer.
491   82E1              DrawBannerPutPixel:
492   82E1 2A 0A 84             LD      HL,(DrawPixelPtr)
493   82E4 3A 05 84             LD      A,(DrawInk)
494   82E7 B7                   OR      A
495   82E8 28 0D                JR      Z,DrawBannerBackground
496   82EA 3A 00 84             LD      A,(ModeBpp)
497   82ED FE 08                CP      8
498   82EF 3E FF                LD      A,$FF
499   82F1 20 05                JR      NZ,DrawBannerPixelValueReady
500   82F3 3E 0F                LD      A,$0F               ; EGA palette entry 15 = white.
501   82F5 18 01                JR      DrawBannerPixelValueReady
502   82F7              DrawBannerBackground:
503   82F7 AF                   XOR     A
504   82F8              DrawBannerPixelValueReady:
505   82F8 4F                   LD      C,A
506   82F9 3A 01 84             LD      A,(DrawBytes)
507   82FC 47                   LD      B,A
508   82FD 79                   LD      A,C
509   82FE              DrawBannerPutPixelByte:
510   82FE 77                   LD      (HL),A
511   82FF 23                   INC     HL
512   8300 10 FC                DJNZ    DrawBannerPutPixelByte
513   8302 22 0A 84             LD      (DrawPixelPtr),HL
514   8305 C9                   RET
515   8306
516   8306              DrawBannerText:
517   8306 50 31 33 32          DEFM    "P132 VGA TEST",0
517   830A 20 56 47 41
517   830E 20 54 45 53
517   8312 54 00
518   8314
519   8314              DebugHexByte:
